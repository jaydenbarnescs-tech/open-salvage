#!/opt/homebrew/bin/node
'use strict';
// salvage-llm — Unified LLM router for salvage sub-agents
// Routes all models through salvage, which handles provider family detection internally:
//   CLI family  (claude-*): subprocess → claude CLI with full session/MCP
//   API family  (everything else): detectBackend() → callLLM() → MCPClientManager agentic loop
//
// Usage:
//   salvage-llm --model <model> -p <prompt> [--workspace <dir>] [--output-format text|stream-json]

const { spawn } = require('child_process');
const path = require('path');
const fs = require('fs');

const HOME = process.env.HOME || '/Users/jayden.csai';
const SALVAGE = path.join(HOME, 'bin/salvage');
const SESSION_DIR = path.join(HOME, '.salvage/llm-sessions');

// ── Parse args ──────────────────────────────────────────────────────────
const args = process.argv.slice(2);
let model = null;
let prompt = null;
let workspace = null;
const extraArgs = [];

for (let i = 0; i < args.length; i++) {
  switch (args[i]) {
    case '--model':     model     = args[++i]; break;
    case '-p':
    case '--prompt':    prompt    = args[++i]; break;
    case '--workspace': workspace = args[++i]; break;
    default:            extraArgs.push(args[i]); break;
  }
}

if (!model || !prompt) {
  console.error('Usage: salvage-llm --model <model> -p <prompt> [--workspace <dir>]');
  process.exit(1);
}

// ── Route through salvage ────────────────────────────────────────────────
// salvage detects provider family internally:
//   claude-*  → CLI family → claude subprocess (owns MCP/session/tools)
//   everything else → API family → detectBackend() → callLLM() + MCPClientManager
//     (mlx-lm :8080 preferred, Ollama :11434 fallback, canary probe for broken parsers)
const ws = workspace || path.join(HOME, 'clawd');
const salvageArgs = [
  '--workspace', ws,
  '--task',    'general',
  '--fresh',
  '--minimal',
  '--no-live-state',
  '--no-memory',
  '--no-mcp',   // skip salvage's built-in MCP for all paths — local LLMs use MCPClientManager instead
  '-p',         prompt,
  '--model',    model,
  '--max-turns', '10',
  '--output-format', 'text',
  '--dangerously-skip-permissions',
  ...extraArgs,
];

// Session logging for HUD visibility
fs.mkdirSync(SESSION_DIR, { recursive: true });
const sessionFile = path.join(SESSION_DIR, `${process.pid}.jsonl`);
fs.appendFileSync(sessionFile, JSON.stringify({
  type: 'message', role: 'user', ts: new Date().toISOString(),
  model, content: prompt.slice(0, 2000),
}) + '\n');

const child = spawn(SALVAGE, salvageArgs, {
  stdio: ['ignore', 'pipe', 'pipe'],
  env: {
    ...process.env,
    PATH: `${HOME}/bin:/opt/homebrew/bin:/opt/homebrew/opt/node/bin:/usr/local/bin:/usr/bin:/bin`,
    HOME,
  },
});

let stdout = '';
child.stdout.on('data', d => { stdout += d; process.stdout.write(d); });
child.stderr.on('data', d => process.stderr.write(d));
child.on('close', code => {
  // Log response for HUD
  fs.appendFileSync(sessionFile, JSON.stringify({
    type: 'message', role: 'assistant', ts: new Date().toISOString(),
    model, content: stdout.trim().slice(0, 4000),
  }) + '\n');
  // Keep last 20 session files
  try {
    const files = fs.readdirSync(SESSION_DIR)
      .filter(f => f.endsWith('.jsonl'))
      .map(f => ({ name: f, mtime: fs.statSync(path.join(SESSION_DIR, f)).mtimeMs }))
      .sort((a, b) => b.mtime - a.mtime);
    for (const f of files.slice(20)) fs.unlinkSync(path.join(SESSION_DIR, f.name));
  } catch {}
  process.exit(code || 0);
});
child.on('error', err => {
  console.error(`[salvage-llm] Error: ${err.message}`);
  process.exit(1);
});
