#!/opt/homebrew/bin/node
'use strict';

const fs = require('fs');
const path = require('path');
const os = require('os');
const { execFileSync, spawn } = require('child_process');

// ── Constants ────────────────────────────────────────────────────────────
const HOME = process.env.HOME || '/Users/jayden.csai';
const DEFAULT_WORKSPACE = path.join(HOME, '.openclaw/workspace');
const GLOBAL_SKILLS_DIR = path.join(HOME, '.salvage/skills');
const GLOBAL_CONFIG_PATH = path.join(HOME, '.salvage/config.json');
const GLOBAL_MCP_CONFIG = path.join(HOME, '.salvage/mcp-config.json');
// Auto-detect Claude binary — survives version updates
const CLAUDE_BIN = (() => {
  const candidates = [
    '/opt/homebrew/bin/claude',
    path.join(HOME, 'bin/claude'),
  ];
  // Also check for latest version directly
  const codeDir = path.join(HOME, 'Library/Application Support/Claude/claude-code');
  try {
    const versions = fs.readdirSync(codeDir).sort().reverse();
    for (const v of versions) {
      candidates.push(path.join(codeDir, v, 'claude.app/Contents/MacOS/claude'));
    }
  } catch {}
  for (const c of candidates) {
    try { if (fs.existsSync(c) && !fs.lstatSync(c).isSymbolicLink() || fs.existsSync(fs.realpathSync(c))) return c; } catch {}
  }
  return '/opt/homebrew/bin/claude'; // fallback
})();
const VAULT = path.join(HOME, 'Library/Mobile Documents/iCloud~md~obsidian/Documents/MGC');
const LOG_DIR = path.join(HOME, 'claude-agent/logs');
const MEM0_PYTHON = path.join(HOME, 'claude-agent/mem0-env/bin/python');
const MEM0_DIR    = path.join(HOME, 'claude-agent/mem0');
const OLLAMA_KEEP_ALIVE = process.env.OLLAMA_KEEP_ALIVE || '5m';

// OpenClaw bootstrap allowlist
const VALID_BOOTSTRAP_NAMES = new Set([
  'AGENTS.md', 'SOUL.md', 'TOOLS.md', 'IDENTITY.md', 'USER.md',
  'HEARTBEAT.md', 'BOOTSTRAP.md', 'MEMORY.md', 'memory.md',
  'COMPANY.md', 'TEAM.md', 'SLACK.md', 'NOTION.md', // workspace-specific extensions
]);

// OpenClaw loading order
const BOOTSTRAP_LOAD_ORDER = [
  'AGENTS.md', 'SOUL.md', 'TOOLS.md', 'IDENTITY.md', 'USER.md',
  'COMPANY.md', 'TEAM.md', 'SLACK.md', 'NOTION.md',
  'HEARTBEAT.md', 'MEMORY.md',
];

// Minimal set for subagent/cron sessions (matches OpenClaw)
const MINIMAL_BOOTSTRAP = new Set([
  'AGENTS.md', 'TOOLS.md', 'SOUL.md', 'IDENTITY.md', 'USER.md',
]);

// Size limits (matches OpenClaw)
const BOOTSTRAP_MAX_CHARS = 20000;       // 20KB per file
const BOOTSTRAP_TOTAL_MAX_CHARS = 150000; // 150KB total
const HEAD_RATIO = 0.7;
const TAIL_RATIO = 0.2;

// Session constants (matches OpenClaw)
const DEFAULT_RESET_AT_HOUR = 4;  // 4am reset (OpenClaw default)
const DEFAULT_RESET_TZ = 'Asia/Tokyo';  // JST for Jayden
const DEFAULT_IDLE_MINUTES = 0;   // disabled by default

// Context window budgeting (matches OpenClaw)
const CHARS_PER_TOKEN = 3.5;          // OpenClaw's estimate (includes CJK)
const SAFETY_MARGIN = 1.2;            // 20% buffer (matches OpenClaw)
const MODEL_CONTEXT_TOKENS = {        // known context windows
  'claude-opus-4': 1048576,           // 1M
  'claude-sonnet-4-6': 1048576,       // 1M
  'claude-sonnet-4-20250514': 1048576,
  'claude-haiku-4-5': 200000,
  'default': 200000,
};
const CONTEXT_WINDOW_HARD_MIN_TOKENS = 16000;  // hard block if below this
const CONTEXT_WINDOW_WARN_BELOW_TOKENS = 32000; // warning if below this
const SYSTEM_PROMPT_MAX_RATIO = 0.4;  // system prompt should use at most 40% of context

// ── Helpers ──────────────────────────────────────────────────────────────
function log(msg) {
  process.stderr.write(`[salvage] ${new Date().toISOString()} ${msg}\n`);
}

function dateStr(offset = 0) {
  const d = new Date();
  d.setDate(d.getDate() + offset);
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}

function nowTimeStr() {
  const d = new Date();
  return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
}

function nowJST() {
  return new Date().toLocaleString('en-US', { timeZone: 'Asia/Tokyo' });
}

function stripFrontmatter(content) {
  return content.replace(/^---[\s\S]*?---\n*/, '').trim();
}

function parseFrontmatter(content) {
  const match = content.match(/^---\n([\s\S]*?)\n---/);
  if (!match) return {};
  const result = {};
  for (const line of match[1].split('\n')) {
    const sep = line.indexOf(':');
    if (sep === -1) continue;
    result[line.slice(0, sep).trim()] = line.slice(sep + 1).trim().replace(/^["']|["']$/g, '');
  }
  return result;
}

function escapeXml(s) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function truncateContent(content, fileName, maxChars) {
  if (content.length <= maxChars) return content;
  const headSize = Math.floor(maxChars * HEAD_RATIO);
  const tailSize = Math.floor(maxChars * TAIL_RATIO);
  const head = content.slice(0, headSize);
  const tail = content.slice(-tailSize);
  log(`WARNING: ${fileName} truncated (${content.length} → ${maxChars} chars)`);
  return `${head}\n\n[...truncated, read ${fileName} for full content...]\n\n${tail}`;
}

function readFileOrEmpty(filePath) {
  try { return fs.readFileSync(filePath, 'utf-8'); } catch { return ''; }
}

// ── Session Management (OpenClaw pattern) ────────────────────────────────

function getSessionStatePath(workspace) {
  return path.join(workspace, 'sessions', 'state.json');
}

function loadSessionState(workspace) {
  const statePath = getSessionStatePath(workspace);
  try {
    return JSON.parse(fs.readFileSync(statePath, 'utf-8'));
  } catch {
    return { sessions: {}, resetPolicy: { mode: 'daily', atHour: DEFAULT_RESET_AT_HOUR, tz: DEFAULT_RESET_TZ, idleMinutes: DEFAULT_IDLE_MINUTES } };
  }
}

function saveSessionState(workspace, state) {
  const dir = path.join(workspace, 'sessions');
  fs.mkdirSync(dir, { recursive: true });
  fs.writeFileSync(getSessionStatePath(workspace), JSON.stringify(state, null, 2));
}

// Matches OpenClaw's resolveDailyResetAtMs logic
function resolveDailyResetAtMs(nowMs, atHour, tz) {
  // Get current time in the target timezone
  const nowInTz = new Date(new Date(nowMs).toLocaleString('en-US', { timeZone: tz }));
  const resetToday = new Date(nowInTz);
  resetToday.setHours(atHour, 0, 0, 0);

  // If current time is before today's reset hour, use yesterday's reset
  if (nowInTz.getTime() < resetToday.getTime()) {
    resetToday.setDate(resetToday.getDate() - 1);
  }

  return resetToday.getTime();
}

function evaluateSessionFreshness(sessionEntry, resetPolicy) {
  const nowMs = Date.now();
  const updatedAt = sessionEntry.updatedAt || 0;

  // Daily reset check
  if (resetPolicy.mode === 'daily') {
    const resetAtMs = resolveDailyResetAtMs(nowMs, resetPolicy.atHour || DEFAULT_RESET_AT_HOUR, resetPolicy.tz || DEFAULT_RESET_TZ);
    if (updatedAt < resetAtMs) {
      return { fresh: false, reason: `daily reset (last active before ${new Date(resetAtMs).toISOString()})` };
    }
  }

  // Idle timeout check
  if (resetPolicy.idleMinutes && resetPolicy.idleMinutes > 0) {
    const idleExpiresAt = updatedAt + (resetPolicy.idleMinutes * 60 * 1000);
    if (nowMs > idleExpiresAt) {
      return { fresh: false, reason: `idle timeout (${resetPolicy.idleMinutes}m)` };
    }
  }

  return { fresh: true, reason: 'session is current' };
}

// Derive session key following OpenClaw's agent:agentId:rest pattern
function deriveSessionKey(workspace, taskType, explicitKey) {
  if (explicitKey) return explicitKey;

  const agentId = path.basename(workspace).replace(/[^a-z0-9-]/gi, '-').toLowerCase();

  switch (taskType) {
    case 'linkedin':
    case 'triage':
    case 'organise':
      // One-shot tasks — no session continuity
      return null;
    default:
      return `salvage:${agentId}:main`;
  }
}

// Decide whether to continue an existing session or start fresh
function resolveSessionAction(workspace, sessionKey, forceFreesh) {
  if (!sessionKey || forceFreesh) {
    return { action: 'fresh', reason: 'no session key or --fresh flag' };
  }

  const state = loadSessionState(workspace);
  const entry = state.sessions[sessionKey];

  if (!entry) {
    return { action: 'new', reason: 'no existing session for this key' };
  }

  const freshness = evaluateSessionFreshness(entry, state.resetPolicy);
  if (!freshness.fresh) {
    log(`Session ${sessionKey} stale: ${freshness.reason}. Starting fresh.`);
    return { action: 'new', reason: freshness.reason };
  }

  return { action: 'continue', reason: 'session is current', sessionName: entry.sessionName || sessionKey };
}

// Update session state after a call
function updateSessionState(workspace, sessionKey, sessionAction) {
  if (!sessionKey) return;

  const state = loadSessionState(workspace);
  const nowMs = Date.now();

  if (!state.sessions[sessionKey]) {
    state.sessions[sessionKey] = {
      sessionKey,
      sessionName: sessionKey,
      createdAt: nowMs,
      updatedAt: nowMs,
      callCount: 0,
      status: 'active',
    };
  }

  const entry = state.sessions[sessionKey];
  entry.updatedAt = nowMs;
  entry.callCount = (entry.callCount || 0) + 1;
  entry.lastTask = taskType;

  // If we started fresh, reset the creation time
  if (sessionAction === 'new') {
    entry.createdAt = nowMs;
    entry.callCount = 1;
  }

  saveSessionState(workspace, state);
}

// ── Error Formatter (OpenClaw pattern: formatAssistantErrorText) ─────────
function formatUserFacingError(code, stderr, stdout) {
  const err = ((stderr || '') + (stdout || '')).toLowerCase();

  // Auth errors
  if (err.includes('not logged in') || err.includes('please run /login') || err.includes('oauth') || err.includes('unauthorized'))
    return { category: 'auth', message: 'Authentication expired. Salvage will try to refresh. If this persists, run: /opt/homebrew/bin/claude auth login', canAutoFix: true };

  // Rate limit
  if (err.includes('rate limit') || err.includes('429') || err.includes('too many requests'))
    return { category: 'rate_limit', message: 'API rate limit reached. Retrying in 30 seconds...', canAutoFix: true };

  // Claude binary missing
  if (err.includes('enoent') || err.includes('spawn') && err.includes('no such file'))
    return { category: 'binary_missing', message: 'Claude CLI binary not found. Auto-detecting latest version...', canAutoFix: true };

  // Context overflow
  if (err.includes('context') && (err.includes('overflow') || err.includes('too large') || err.includes('exceeded')))
    return { category: 'context_overflow', message: 'Conversation too long. Starting fresh session.', canAutoFix: true };

  // Timeout
  if (err.includes('timeout') || err.includes('timed out'))
    return { category: 'timeout', message: 'Request timed out. Retrying with a simpler prompt...', canAutoFix: true };

  // Overloaded
  if (err.includes('overloaded') || err.includes('503') || err.includes('capacity'))
    return { category: 'overloaded', message: 'AI service temporarily overloaded. Retrying in a moment...', canAutoFix: true };

  // Max turns
  if (err.includes('max turns') || err.includes('reached max'))
    return { category: 'max_turns', message: 'Ran out of processing turns. Try a simpler request or start a new session.', canAutoFix: false };

  // Network
  if (err.includes('econnrefused')) return { category: 'network', message: 'Connection refused. A required service may be down.', canAutoFix: false };
  if (err.includes('econnreset') || err.includes('epipe')) return { category: 'network', message: 'Network connection interrupted. Retrying...', canAutoFix: true };
  if (err.includes('enotfound') || err.includes('dns')) return { category: 'network', message: 'DNS lookup failed. Check internet connection.', canAutoFix: false };

  // Billing
  if (err.includes('billing') || err.includes('credits') || err.includes('insufficient balance'))
    return { category: 'billing', message: 'API billing issue. Check your subscription status.', canAutoFix: false };

  // Unknown — sanitize and truncate
  const sanitized = (stderr || stdout || 'Unknown error').slice(0, 200).replace(/\n/g, ' ').trim();
  return { category: 'unknown', message: `Unexpected error: ${sanitized}`, canAutoFix: false };
}

// ── Preflight Validation (OpenClaw Tier 0) ───────────────────────────────
function runPreflightChecks() {
  const issues = [];

  // Check Claude binary exists
  try {
    if (!fs.existsSync(CLAUDE_BIN)) {
      // Try to fix: find latest version
      const codeDir = path.join(HOME, 'Library/Application Support/Claude/claude-code');
      try {
        const versions = fs.readdirSync(codeDir).sort().reverse();
        for (const v of versions) {
          const candidate = path.join(codeDir, v, 'claude.app/Contents/MacOS/claude');
          if (fs.existsSync(candidate)) {
            // Fix the symlinks
            try { fs.unlinkSync('/opt/homebrew/bin/claude'); } catch {}
            try { fs.unlinkSync(path.join(HOME, 'bin/claude')); } catch {}
            fs.symlinkSync(candidate, path.join(HOME, 'bin/claude'));
            try { fs.symlinkSync(candidate, '/opt/homebrew/bin/claude'); } catch {}
            log(`PREFLIGHT: Fixed Claude binary symlink → ${v}`);
            break;
          }
        }
      } catch { issues.push('Claude CLI binary not found and could not auto-fix'); }
    }
  } catch { issues.push('Could not verify Claude binary'); }

  // Check OAuth token exists
  const tokenFile = path.join(HOME, '.claude-setup-token');
  try {
    if (!fs.existsSync(tokenFile)) {
      issues.push('OAuth token file missing (~/.claude-setup-token)');
    } else {
      const token = fs.readFileSync(tokenFile, 'utf-8').trim();
      if (!token || token.length < 20) issues.push('OAuth token appears invalid');
    }
  } catch { issues.push('Could not read OAuth token'); }

  // Check workspace exists and has required files
  if (!fs.existsSync(WORKSPACE)) {
    issues.push(`Workspace not found: ${WORKSPACE}`);
  } else {
    const required = ['SOUL.md', 'IDENTITY.md'];
    for (const f of required) {
      if (!fs.existsSync(path.join(WORKSPACE, f))) {
        issues.push(`Required workspace file missing: ${f}`);
      }
    }
  }

  return issues;
}

// ── Context Window Budgeting ─────────────────────────────────────────────

function estimateTokens(text) {
  return Math.ceil((text || '').length / CHARS_PER_TOKEN);
}

function resolveModelContextWindow(passThroughArgs) {
  // Extract model from pass-through args
  let model = 'default';
  for (let i = 0; i < passThroughArgs.length; i++) {
    if (passThroughArgs[i] === '--model') {
      model = passThroughArgs[i + 1] || 'default';
      break;
    }
  }

  // Normalize model aliases
  const normalized = model.toLowerCase();
  if (normalized.includes('opus')) return MODEL_CONTEXT_TOKENS['claude-opus-4'];
  if (normalized.includes('sonnet')) return MODEL_CONTEXT_TOKENS['claude-sonnet-4-6'];
  if (normalized.includes('haiku')) return MODEL_CONTEXT_TOKENS['claude-haiku-4-5'];

  return MODEL_CONTEXT_TOKENS[model] || MODEL_CONTEXT_TOKENS['default'];
}

function evaluateContextBudget(systemPromptText, passThroughArgs) {
  const promptTokens = estimateTokens(systemPromptText);
  const contextWindow = resolveModelContextWindow(passThroughArgs);
  const maxPromptTokens = Math.floor(contextWindow * SYSTEM_PROMPT_MAX_RATIO);
  const remainingForHistory = contextWindow - Math.ceil(promptTokens * SAFETY_MARGIN);

  const result = {
    promptTokens,
    promptChars: systemPromptText.length,
    contextWindow,
    maxPromptTokens,
    remainingForHistory,
    status: 'ok',
    warnings: [],
  };

  // Check if system prompt exceeds safe ratio
  if (promptTokens > maxPromptTokens) {
    result.status = 'warning';
    result.warnings.push(
      `System prompt (${promptTokens} tokens) exceeds ${Math.round(SYSTEM_PROMPT_MAX_RATIO * 100)}% ` +
      `of context window (${maxPromptTokens} tokens). Consider reducing bootstrap files or skills.`
    );
  }

  // Check remaining space for conversation
  if (remainingForHistory < CONTEXT_WINDOW_HARD_MIN_TOKENS) {
    result.status = 'critical';
    result.warnings.push(
      `CRITICAL: Only ${remainingForHistory} tokens remaining for conversation ` +
      `(minimum: ${CONTEXT_WINDOW_HARD_MIN_TOKENS}). Claude may fail to respond.`
    );
  } else if (remainingForHistory < CONTEXT_WINDOW_WARN_BELOW_TOKENS) {
    result.status = result.status === 'ok' ? 'warning' : result.status;
    result.warnings.push(
      `Low headroom: ${remainingForHistory} tokens remaining for conversation ` +
      `(recommended minimum: ${CONTEXT_WINDOW_WARN_BELOW_TOKENS}).`
    );
  }

  return result;
}

// ── Hooks System (OpenClaw pattern) ──────────────────────────────────────

function discoverHooks(workspace, eventName) {
  const hooksDir = path.join(workspace, 'hooks');
  if (!fs.existsSync(hooksDir)) return [];

  const hooks = [];
  let entries;
  try { entries = fs.readdirSync(hooksDir); } catch { return []; }

  for (const entry of entries) {
    const hookDir = path.join(hooksDir, entry);
    const stat = fs.statSync(hookDir);

    if (stat.isDirectory()) {
      // OpenClaw pattern: directory with HOOK.md + handler.js
      const hookMd = path.join(hookDir, 'HOOK.md');
      const handlerJs = path.join(hookDir, 'handler.js');
      if (!fs.existsSync(handlerJs)) continue;

      const meta = fs.existsSync(hookMd) ? parseFrontmatter(readFileOrEmpty(hookMd)) : {};
      const events = (meta.events || eventName).split(',').map(s => s.trim());

      if (events.includes(eventName) || events.includes('*')) {
        hooks.push({ name: entry, handler: handlerJs, type: 'module', meta });
      }
    } else if (entry.startsWith(`${eventName}.`) && (entry.endsWith('.sh') || entry.endsWith('.js'))) {
      // Simple pattern: before-call.sh, after-call.js
      hooks.push({ name: entry, handler: hookDir, type: entry.endsWith('.sh') ? 'shell' : 'module', meta: {} });
    }
  }

  return hooks.sort((a, b) => a.name.localeCompare(b.name));
}

async function executeHooks(workspace, eventName, context) {
  const hooks = discoverHooks(workspace, eventName);
  if (hooks.length === 0) return;

  for (const hook of hooks) {
    try {
      log(`Hook: ${eventName} → ${hook.name}`);

      if (hook.type === 'shell') {
        execFileSync('bash', [hook.handler], {
          encoding: 'utf-8',
          timeout: 10000,
          env: {
            ...process.env,
            SALVAGE_WORKSPACE: workspace,
            SALVAGE_TASK: context.taskType || '',
            SALVAGE_SESSION_KEY: context.sessionKey || '',
            SALVAGE_PROMPT_TOKENS: String(context.promptTokens || 0),
            SALVAGE_EXIT_CODE: String(context.exitCode || 0),
          },
        });
      } else if (hook.type === 'module') {
        const mod = require(hook.handler);
        if (typeof mod === 'function') {
          await mod(context);
        } else if (typeof mod.default === 'function') {
          await mod.default(context);
        } else if (typeof mod[eventName.replace(/-/g, '')] === 'function') {
          await mod[eventName.replace(/-/g, '')](context);
        }
      }
    } catch (e) {
      log(`WARNING: Hook ${hook.name} failed: ${e.message}`);
    }
  }
}

// ── Plugin System ────────────────────────────────────────────────────────
// Plugins are directories in {workspace}/plugins/ or ~/.salvage/plugins/
// Each plugin directory contains a manifest.json:
//   { name, description, provides: ["context"|"hook"|"tool"], entry: "index.js" }

function discoverPlugins(workspace) {
  const pluginDirs = [
    path.join(workspace, 'plugins'),
    path.join(HOME, '.salvage/plugins'),
  ];

  const plugins = [];
  const seen = new Set();

  for (const dir of pluginDirs) {
    if (!fs.existsSync(dir)) continue;
    let entries;
    try { entries = fs.readdirSync(dir); } catch { continue; }

    for (const entry of entries) {
      const pluginDir = path.join(dir, entry);
      if (!fs.statSync(pluginDir).isDirectory()) continue;

      const manifestPath = path.join(pluginDir, 'manifest.json');
      if (!fs.existsSync(manifestPath)) continue;

      try {
        const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf-8'));
        const name = manifest.name || entry;

        // Workspace plugins override global (same as skills)
        if (seen.has(name)) continue;
        seen.add(name);

        plugins.push({
          name,
          description: manifest.description || '',
          provides: manifest.provides || [],
          entry: manifest.entry || 'index.js',
          dir: pluginDir,
          manifest,
        });
      } catch (e) {
        log(`WARNING: Plugin ${entry} manifest error: ${e.message}`);
      }
    }
  }

  return plugins;
}

function loadPluginContextSections(plugins) {
  const contextSections = [];
  for (const plugin of plugins) {
    if (!plugin.provides.includes('context')) continue;
    try {
      const mod = require(path.join(plugin.dir, plugin.entry));
      if (typeof mod.getContext === 'function') {
        const ctx = mod.getContext({ workspace: WORKSPACE, taskType, config });
        if (ctx) contextSections.push(`# Plugin: ${plugin.name}\n\n${ctx}`);
      }
    } catch (e) {
      log(`WARNING: Plugin ${plugin.name} context error: ${e.message}`);
    }
  }
  return contextSections;
}

// ── Mem0 memory cache (5-min TTL) ────────────────────────────────────────
let memoryCache     = null;
let memoryCacheTime = 0;
const MEMORY_CACHE_TTL = 5 * 60 * 1000; // 5 minutes

function getCachedMemory() {
  if (memoryCache && (Date.now() - memoryCacheTime) < MEMORY_CACHE_TTL) {
    return memoryCache;
  }
  try {
    const raw = execFileSync(
      MEM0_PYTHON,
      [path.join(MEM0_DIR, 'all.py')],
      {
        timeout: 30_000,
        encoding: 'utf-8',
        env: { ...process.env, HOME, PATH: `${HOME}/bin:/opt/homebrew/opt/node/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin` },
      }
    ).trim();
    if (raw && raw.includes('# Vanessa Core Memory')) {
      memoryCache     = raw;
      memoryCacheTime = Date.now();
      return raw;
    }
  } catch (e) {
    // Non-fatal — log will be available once log() is defined
  }
  return null;
}

function getMemoryContext(query) {
  const allMemory = getCachedMemory();
  if (!allMemory) return null;

  // If there's a meaningful query, run search.py for relevance-ranked top results
  if (query && query.trim().length >= 10) {
    try {
      const searchOut = execFileSync(
        MEM0_PYTHON,
        [path.join(MEM0_DIR, 'search.py'), query.trim().slice(0, 500), '3'],
        {
          timeout: 15_000,
          encoding: 'utf-8',
          env: { ...process.env, HOME, PATH: `${HOME}/bin:/opt/homebrew/opt/node/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin` },
        }
      ).trim();
      const hits = JSON.parse(searchOut);
      if (Array.isArray(hits) && hits.length > 0) {
        const relevant = hits.map(h => `- ${h.memory}`).join('\n');
        return `## Most Relevant\n\n${relevant}\n\n---\n\n${allMemory}`;
      }
    } catch { /* search is best-effort, fall through to full context */ }
  }

  return allMemory;
}

// ── Parse args ───────────────────────────────────────────────────────────
const args = process.argv.slice(2);
let taskType = 'general';
let workspacePath = null;
let profileName = null;
let sessionKey = null;
let noMemory = false;
let noLiveState = false;
let noMcp = false;
let minimal = false;
let fresh = false;
let dryRun = false;
let taskId = null;  // Links execution to a SQLite task
let threadTs = null; // Slack thread_ts for session keying
const passThroughArgs = [];

for (let i = 0; i < args.length; i++) {
  switch (args[i]) {
    case '--task':
      taskType = args[++i] || 'general';
      break;
    case '--workspace':
      workspacePath = args[++i];
      break;
    case '--profile':
      profileName = args[++i];
      break;
    case '--session-key':
      sessionKey = args[++i];
      break;
    case '--no-memory':
      noMemory = true;
      break;
    case '--no-live-state':
      noLiveState = true;
      break;
    case '--no-mcp':
      noMcp = true;
      break;
    case '--minimal':
      minimal = true;
      break;
    case '--fresh':
      fresh = true;
      break;
    case '--dry-run':
      dryRun = true;
      break;
    case '--task-id':
      taskId = args[++i];
      break;
    case '--thread-ts':
      threadTs = args[++i] || null;
      break;
    default:
      passThroughArgs.push(args[i]);
  }
}

// ── Resolve workspace ────────────────────────────────────────────────────
let WORKSPACE;
if (workspacePath) {
  WORKSPACE = path.resolve(workspacePath);
} else if (profileName) {
  WORKSPACE = path.join(HOME, `.openclaw/workspace-${profileName}`);
} else {
  WORKSPACE = DEFAULT_WORKSPACE;
}

if (!fs.existsSync(WORKSPACE)) {
  log(`FATAL: Workspace not found: ${WORKSPACE}`);
  process.exit(1);
}

// ── Load config ──────────────────────────────────────────────────────────
// Workspace config takes priority over global
const wsConfigPath = path.join(WORKSPACE, 'salvage.json');
let config;
try {
  config = JSON.parse(fs.readFileSync(
    fs.existsSync(wsConfigPath) ? wsConfigPath : GLOBAL_CONFIG_PATH, 'utf-8'
  ));
} catch (e) {
  log(`WARNING: No config found: ${e.message}. Using defaults.`);
  config = {
    skills: { alwaysInject: [] },
    rateLimit: { retryWaitSeconds: 30, maxRetries: 1 },
  };
}

// ── 1. Load bootstrap files (OpenClaw order, with size limits) ───────────
const sections = [];
let totalChars = 0;

const allowedFiles = minimal ? MINIMAL_BOOTSTRAP : VALID_BOOTSTRAP_NAMES;

for (const fileName of BOOTSTRAP_LOAD_ORDER) {
  if (!allowedFiles.has(fileName)) continue;

  // Skip MEMORY.md if noMemory or minimal
  if ((fileName === 'MEMORY.md' || fileName === 'memory.md') && (noMemory || minimal)) continue;

  const filePath = path.join(WORKSPACE, fileName);
  const raw = readFileOrEmpty(filePath);
  if (!raw.trim()) continue;

  let content = stripFrontmatter(raw);
  if (!content) continue;

  // Enforce per-file limit
  if (content.length > BOOTSTRAP_MAX_CHARS) {
    content = truncateContent(content, fileName, BOOTSTRAP_MAX_CHARS);
  }

  // Enforce total limit
  if (totalChars + content.length > BOOTSTRAP_TOTAL_MAX_CHARS) {
    const remaining = BOOTSTRAP_TOTAL_MAX_CHARS - totalChars;
    if (remaining < 64) {
      log(`WARNING: Total bootstrap limit reached. Skipping ${fileName}`);
      continue;
    }
    content = truncateContent(content, fileName, remaining);
  }

  sections.push(content);
  totalChars += content.length;
}

// ── 2. Load skills as XML listing (on-demand, OpenClaw style) ────────────
const skillDirs = [];

// Workspace skills first (higher priority)
const wsSkillsDir = path.join(WORKSPACE, 'skills');
if (fs.existsSync(wsSkillsDir)) skillDirs.push(wsSkillsDir);

// Global/bundled skills as fallback
if (fs.existsSync(GLOBAL_SKILLS_DIR)) skillDirs.push(GLOBAL_SKILLS_DIR);

const skillEntries = [];   // {name, description, location} for XML listing
const alwaysInject = new Set(config.skills?.alwaysInject || []);
const alwaysInjectedContent = [];

const seenSkills = new Set();

for (const dir of skillDirs) {
  let files;
  try { files = fs.readdirSync(dir); } catch { continue; }

  for (const file of files) {
    const filePath = path.join(dir, file);
    const stat = fs.statSync(filePath);

    let skillFile;
    if (stat.isDirectory()) {
      // Skill as directory with SKILL.md inside
      skillFile = path.join(filePath, 'SKILL.md');
      if (!fs.existsSync(skillFile)) continue;
    } else if (file.endsWith('.md')) {
      skillFile = filePath;
    } else {
      continue;
    }

    const raw = readFileOrEmpty(skillFile);
    if (!raw.trim()) continue;

    const fm = parseFrontmatter(raw);
    const skillName = fm.name || path.basename(file, '.md');

    // Deduplicate (workspace skills override global)
    if (seenSkills.has(skillName)) continue;
    seenSkills.add(skillName);

    const description = fm.description || '';

    // Always-inject skills get full content in prompt
    if (alwaysInject.has(skillName)) {
      const content = stripFrontmatter(raw);
      if (content) {
        alwaysInjectedContent.push(`# Skill: ${skillName}\n\n${content}`);
      }
    } else {
      // All other skills: compact XML listing only
      const compactPath = skillFile.replace(HOME, '~');
      skillEntries.push({ name: skillName, description, location: compactPath });
    }
  }
}

// Add always-injected skills to sections
for (const content of alwaysInjectedContent) {
  sections.push(content);
}

// Add XML skill listing
if (skillEntries.length > 0) {
  const xmlLines = [
    'The following skills provide specialized instructions for specific tasks.',
    "Use the read tool to load a skill's file when the task matches its description.",
    "When a skill file references a relative path, resolve it against the skill directory (parent of SKILL.md / dirname of the path) and use that absolute path in tool commands.",
    '',
    '<available_skills>',
  ];
  for (const skill of skillEntries) {
    xmlLines.push('  <skill>');
    xmlLines.push(`    <name>${escapeXml(skill.name)}</name>`);
    xmlLines.push(`    <description>${escapeXml(skill.description)}</description>`);
    xmlLines.push(`    <location>${escapeXml(skill.location)}</location>`);
    xmlLines.push('  </skill>');
  }
  xmlLines.push('</available_skills>');
  sections.push(xmlLines.join('\n'));
}

// ── 2b. Load plugin context ──────────────────────────────────────────────
const plugins = discoverPlugins(WORKSPACE);
const pluginContextSections = loadPluginContextSections(plugins);
for (const section of pluginContextSections) {
  sections.push(section);
}

// ── CACHE BOUNDARY ──────────────────────────────────────────────────────
// Everything above this point is stable across turns (bootstrap + skills + plugins).
// Everything below changes per-turn (memory, live state, time).
// This boundary helps Anthropic's prompt caching.
sections.push('<!-- CACHE_BOUNDARY: stable sections above, dynamic sections below -->');

// Session recovery context is injected after session resolution (see below)

// ── 3. Memory file hints (on-demand, not auto-injected) ──────────────────
if (!noMemory && !minimal) {
  const memoryDir = path.join(WORKSPACE, 'memory');
  const today = dateStr(0);
  const yesterday = dateStr(-1);
  const hints = [];

  const todayFile = path.join(memoryDir, `${today}.md`);
  const yesterdayFile = path.join(memoryDir, `${yesterday}.md`);

  if (fs.existsSync(todayFile)) {
    hints.push(`- ${todayFile.replace(HOME, '~')} (today)`);
  }
  if (fs.existsSync(yesterdayFile)) {
    hints.push(`- ${yesterdayFile.replace(HOME, '~')} (yesterday)`);
  }

  const memoryLines = [];
  if (hints.length > 0) {
    memoryLines.push(`Daily notes available (use read tool if needed):`);
    memoryLines.push(...hints);
  }
  memoryLines.push('');
  memoryLines.push(`To search across all memory files, run: salvage-memory-search "${WORKSPACE}" "<query>"`);
  memoryLines.push('This searches MEMORY.md and all daily notes. Returns matching lines with context.');
  sections.push(`# Memory\n\n${memoryLines.join('\n')}`);
}

// ── 3b. CLI tools auto-discovery + External tool access ─────────────────

// Auto-discover from tools.json registry
const TOOLS_REGISTRY = path.join(HOME, '.salvage/tools.json');
const cliToolLines = [];

try {
  const registry = JSON.parse(fs.readFileSync(TOOLS_REGISTRY, 'utf-8'));
  for (const tool of (registry.tools || [])) {
    cliToolLines.push(`- **${tool.name}**: ${tool.description}`);
    if (tool.examples && tool.examples.length > 0) {
      cliToolLines.push(`  Usage: \`${tool.examples[0]}\``);
    }
  }
} catch {}

// Auto-discover scripts in ~/bin/ not already in registry
try {
  const registeredNames = new Set();
  try {
    const reg = JSON.parse(fs.readFileSync(TOOLS_REGISTRY, 'utf-8'));
    (reg.tools || []).forEach(t => registeredNames.add(t.name));
  } catch {}

  const binFiles = fs.readdirSync(path.join(HOME, 'bin'));
  for (const f of binFiles) {
    if (registeredNames.has(f)) continue;
    const fp = path.join(HOME, 'bin', f);
    try {
      const stat = fs.statSync(fp);
      if (!stat.isFile()) continue;
      // Skip non-scripts (images, etc.)
      if (f.match(/\.(jpg|png|gif|ico)$/)) continue;
      // Try to read first useful comment line
      const head = fs.readFileSync(fp, 'utf-8').slice(0, 500);
      const descMatch = head.match(/^#[^!]\s*(.+)/m) || head.match(/^\/\/\s*(.+)/m);
      if (descMatch) {
        cliToolLines.push(`- **${f}**: ${descMatch[1].trim()}`);
      }
    } catch {}
  }
} catch {}

if (cliToolLines.length > 0) {
  sections.push(`# Local CLI Tools\n\nAvailable commands on this Mac (run via bash):\n${cliToolLines.join('\n')}`);
}

// External MCP tool access
sections.push(`# External Tools

When you need to use external services (Notion, n8n, Slack API, server management, GitHub, image generation, etc.), use this command:

\`\`\`
salvage-tools "${WORKSPACE}" "<describe what you need done>"
\`\`\`

This spawns a sub-agent with full MCP tool access. Examples:
- \`salvage-tools "${WORKSPACE}" "Read the Notion page for RENPHO project"\`
- \`salvage-tools "${WORKSPACE}" "List active n8n workflows"\`
- \`salvage-tools "${WORKSPACE}" "Search Google for latest AI agent frameworks"\`
- \`salvage-tools "${WORKSPACE}" "Post to Slack channel C09DR06AY3V: meeting at 3pm"\`

The sub-agent has access to: Notion, n8n, GitHub, ElevenLabs, LINE, Apify, Serper web search, Oracle VM server management, Supabase, Google Slides/Docs, Instagram, Unsplash, Slack, Vercel, and Gemini image generation.

Use this when you need data from external services. For simple conversation, do NOT use this — just respond directly.

## Sub-Agent Spawning (for complex multi-step tasks)

When you need to divide a large task into parallel or sequential sub-tasks, use:

\`\`\`
salvage-spawn "${WORKSPACE}" '{"tasks":[{"id":"t1","instruction":"Do X"},{"id":"t2","instruction":"Do Y"}]}'
\`\`\`

Or for a single focused sub-task:
\`\`\`
salvage-spawn "${WORKSPACE}" "Do this specific thing"
\`\`\`

Add \`--parallel\` flag to run tasks simultaneously (max 3 concurrent).

Returns structured JSON with status and output for each task. Use this for:
- Research tasks that can be parallelized
- Multi-step workflows where each step is independent
- Any task that would exceed your turn limit if done alone

Safeguards: max 3 tasks per call, 60s timeout per task, sub-agents cannot spawn further sub-agents.`);

// ── 4. Live state ────────────────────────────────────────────────────────
if (!noLiveState) {
  const liveStateParts = [];

  try {
    const launchctlOutput = execFileSync('bash', ['-c', 'launchctl list 2>/dev/null | grep -E "(mgc|claude|openclaw)" || true'], {
      encoding: 'utf-8', timeout: 5000
    }).trim();
    if (launchctlOutput) {
      liveStateParts.push(`## Active LaunchAgents\n\`\`\`\n${launchctlOutput}\n\`\`\``);
    }
  } catch (e) {
    log(`WARNING: Could not read LaunchAgents: ${e.message}`);
  }

  try {
    const vaultFiles = fs.readdirSync(VAULT).filter(f => f.match(/^voice-.*\.md$/));
    liveStateParts.push(`## Vault Status\nRaw voice notes waiting: ${vaultFiles.length}`);
  } catch { /* vault may not exist for this workspace */ }

  const linkedinLog = path.join(LOG_DIR, 'linkedin.log');
  try {
    const logContent = execFileSync('tail', ['-15', linkedinLog], {
      encoding: 'utf-8', timeout: 3000
    }).trim();
    if (logContent) {
      liveStateParts.push(`## Recent LinkedIn Log\n\`\`\`\n${logContent}\n\`\`\``);
    }
  } catch { /* no log, skip */ }

  if (liveStateParts.length > 0) {
    sections.push(`# Live System State\n\n${liveStateParts.join('\n\n')}`);
  }
}

// ── 5. Turn efficiency instruction ───────────────────────────────────────
sections.push(`# Important: Turn Efficiency
All workspace files (SOUL.md, USER.md, TOOLS.md, IDENTITY.md, COMPANY.md, TEAM.md, SLACK.md, NOTION.md, AGENTS.md, HEARTBEAT.md, MEMORY.md) are already loaded above. Do NOT read them again via the read tool — that wastes turns. Only use the read tool for files NOT already in this prompt (skills, memory daily notes, external files).`);

// ── 5b. Date/time ────────────────────────────────────────────────────────
sections.push(`# Current Time\n\n${nowJST()} (JST)`);

// ── 6. Assemble system prompt ────────────────────────────────────────────
const systemPrompt = sections.join('\n\n---\n\n');

// ── 7. Resolve session ──────────────────────────────────────────────────
const resolvedSessionKey = deriveSessionKey(WORKSPACE, taskType, sessionKey);
const sessionDecision = resolveSessionAction(WORKSPACE, resolvedSessionKey, fresh);

// ── 7a. Session recovery context ─────────────────────────────────────────
const sessionSummaryPath = path.join(WORKSPACE, 'sessions', '.last-session-summary.md');
if (sessionDecision.action !== 'continue') {
  const summary = readFileOrEmpty(sessionSummaryPath).trim();
  if (summary) {
    sections.push(`# Recent Context (auto-recovered)\n\n${summary}`);
    log('Session recovery: injected recent context summary');
  }
}

// ── 7b. Mem0 memory injection (non-continue sessions only) ───────────────
if (sessionDecision.action !== 'continue' && !noMemory && !minimal) {
  let incomingMsg = '';
  for (let i = 0; i < passThroughArgs.length; i++) {
    if (passThroughArgs[i] === '-p' || passThroughArgs[i] === '--prompt') {
      incomingMsg = passThroughArgs[i + 1] || '';
      break;
    }
  }
  try {
    const memCtx = getMemoryContext(incomingMsg);
    if (memCtx) {
      sections.unshift(`# Vanessa Memory\n\n${memCtx}`);
      log('mem0: injected memory context into system prompt');
    } else {
      log('mem0: no memories found, skipping injection');
    }
  } catch (e) {
    log(`mem0: injection failed (non-fatal): ${e.message?.slice(0, 100) || e}`);
  }
}

// Reassemble system prompt with recovery context (may have new sections)
const systemPromptWithRecovery = sections.join('\n\n---\n\n');

// ── 7b. Context budget evaluation ───────────────────────────────────────
const budget = evaluateContextBudget(systemPromptWithRecovery, passThroughArgs);

// Log warnings
for (const warn of budget.warnings) {
  log(`BUDGET ${budget.status.toUpperCase()}: ${warn}`);
}

// Hard block if critical
if (budget.status === 'critical' && !dryRun) {
  log('FATAL: System prompt too large for context window. Use --minimal or reduce workspace files.');
  process.exit(1);
}

// ── Dry run ──────────────────────────────────────────────────────────────
if (dryRun) {
  process.stdout.write(systemPromptWithRecovery);
  process.stdout.write(`\n\n--- SALVAGE v2 DRY RUN ---\n`);
  process.stdout.write(`Workspace: ${WORKSPACE}\n`);
  process.stdout.write(`Task: ${taskType}\n`);
  process.stdout.write(`Session key: ${resolvedSessionKey || '(none)'}\n`);
  process.stdout.write(`Session action: ${sessionDecision.action} (${sessionDecision.reason})\n`);
  process.stdout.write(`Memory: ${noMemory ? 'off' : 'on'}\n`);
  process.stdout.write(`Minimal: ${minimal ? 'yes' : 'no'}\n`);
  process.stdout.write(`Live state: ${noLiveState ? 'off' : 'on'}\n`);
  process.stdout.write(`Skills injected: ${alwaysInjectedContent.length}\n`);
  process.stdout.write(`Skills listed (on-demand): ${skillEntries.length}\n`);
  process.stdout.write(`Plugins loaded: ${plugins.length}${plugins.length ? ' (' + plugins.map(p => p.name).join(', ') + ')' : ''}\n`);
  const wsMcp = path.join(WORKSPACE, 'mcp-config.json');
  const mcpPath = fs.existsSync(wsMcp) ? wsMcp : GLOBAL_MCP_CONFIG;
  if (!noMcp && !minimal && fs.existsSync(mcpPath)) {
    try {
      const mcpData = JSON.parse(fs.readFileSync(mcpPath, 'utf-8'));
      const servers = Object.keys(mcpData.mcpServers || {});
      process.stdout.write(`MCP servers: ${servers.length} (${servers.join(', ')})\n`);
    } catch { process.stdout.write(`MCP servers: error reading config\n`); }
  } else {
    process.stdout.write(`MCP servers: ${noMcp ? 'disabled' : 'none'}\n`);
  }
  process.stdout.write(`Bootstrap files: ${totalChars} chars\n`);
  process.stdout.write(`System prompt: ${systemPromptWithRecovery.length} chars (~${budget.promptTokens} tokens)\n`);
  process.stdout.write(`Context window: ${budget.contextWindow} tokens\n`);
  process.stdout.write(`Remaining for history: ${budget.remainingForHistory} tokens\n`);
  process.stdout.write(`Budget status: ${budget.status}${budget.warnings.length ? ' — ' + budget.warnings[0] : ''}\n`);
  process.stdout.write(`Pass-through args: ${passThroughArgs.join(' ')}\n`);
  process.exit(0);
}

// ── 7. Write system prompt to temp file ──────────────────────────────────
const tmpFile = path.join(os.tmpdir(), `salvage-${Date.now()}.txt`);
fs.writeFileSync(tmpFile, systemPromptWithRecovery, 'utf-8');

function cleanup() {
  try { fs.unlinkSync(tmpFile); } catch {}
  if (activeMcpManager) { try { activeMcpManager.cleanup(); } catch {} activeMcpManager = null; }
}

// ── 8. Build Claude CLI args ─────────────────────────────────────────────
function buildClaudeArgs() {
  const claudeArgs = ['--system-prompt-file', tmpFile];

  // Session management based on freshness evaluation
  switch (sessionDecision.action) {
    case 'continue':
      // Session is current — resume it
      claudeArgs.push('--name', resolvedSessionKey);
      claudeArgs.push('--continue');
      log(`Session: continuing ${resolvedSessionKey}`);
      break;
    case 'new':
      // Session is stale or new — start fresh with name
      claudeArgs.push('--name', resolvedSessionKey);
      log(`Session: new ${resolvedSessionKey} (${sessionDecision.reason})`);
      break;
    case 'fresh':
      // No session tracking (one-shot tasks)
      log(`Session: one-shot (${sessionDecision.reason})`);
      break;
  }

  // MCP config — connect to proxy and local MCP servers
  if (!noMcp) {
    // Check for workspace-level MCP config first, then global
    const wsMcpConfig = path.join(WORKSPACE, 'mcp-config.json');
    const mcpConfigPath = fs.existsSync(wsMcpConfig) ? wsMcpConfig : GLOBAL_MCP_CONFIG;
    if (fs.existsSync(mcpConfigPath)) {
      claudeArgs.push('--mcp-config', mcpConfigPath);
      log(`MCP: loaded ${path.basename(mcpConfigPath)} from ${path.dirname(mcpConfigPath)}`);
    }
  }

  // Pass through all other args
  claudeArgs.push(...passThroughArgs);

  return claudeArgs;
}

// ── 9. Build environment with OAuth token ────────────────────────────────
function buildEnv() {
  const env = {
    ...process.env,
    PATH: '/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:' + path.join(HOME, 'bin'),
  };
  const tokenFile = path.join(HOME, '.claude-setup-token');
  try {
    if (fs.existsSync(tokenFile)) {
      env.CLAUDE_CODE_OAUTH_TOKEN = fs.readFileSync(tokenFile, 'utf-8').trim();
    }
  } catch {}
  return env;
}

// ── 10. Call Claude / Local LLM ──────────────────────────────────────────
let activeClaudeChild = null; // tracked for SIGTERM propagation
let activeMcpManager = null;  // tracked for cleanup on exit

// ── MCPClientManager ──────────────────────────────────────────────────────
// Connects to MCP servers via JSON-RPC 2.0 over stdio (Content-Length framing).
// Follows the MCPManager pattern from ollama-mcp-bridge.
// Pre-warmed at process start so cold-start latency (npx -y) doesn't block inference.
class MCPClientManager {
  constructor() {
    this.servers = new Map(); // name → { proc, buf, pending, nextId }
    this.tools = [];          // OpenAI function format with _server/_toolName metadata
  }

  async load(configPath) {
    let config;
    try { config = JSON.parse(fs.readFileSync(configPath, 'utf-8')); }
    catch (e) { log(`MCPClientManager: cannot load ${configPath}: ${e.message}`); return; }

    // Connect servers sequentially to preserve config order in this.tools.
    // Promise.allSettled (parallel) caused non-deterministic tool ordering because
    // faster-starting servers (direct node script) would beat slower ones (npx cold start).
    const servers = config.mcpServers || {};
    for (const [name, cfg] of Object.entries(servers)) {
      await this._connectServer(name, cfg).catch(e =>
        log(`MCPClientManager: ${name} failed to connect: ${e.message}`)
      );
    }
    log(`MCPClientManager: ready — ${this.tools.length} tools from ${this.servers.size} servers`);
  }

  async _connectServer(name, cfg) {
    if (!cfg.command) return;
    const serverEnv = {
      PATH: '/opt/homebrew/opt/node/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin',
      HOME,
      ...process.env,
      ...(cfg.env || {}),
    };
    const proc = spawn(cfg.command, cfg.args || [], {
      stdio: ['pipe', 'pipe', 'pipe'],
      env: serverEnv,
    });

    const state = { proc, buf: '', pending: new Map(), nextId: 1 };
    this.servers.set(name, state);

    proc.stdout.on('data', chunk => {
      state.buf += chunk.toString();
      this._drainLines(name, state);
    });
    proc.stderr.on('data', chunk =>
      log(`MCP[${name}] stderr: ${chunk.toString().trim().slice(0, 200)}`)
    );
    proc.on('error', e => { log(`MCP[${name}] error: ${e.message}`); this.servers.delete(name); });
    proc.on('exit', code => { log(`MCP[${name}] exited: ${code}`); this.servers.delete(name); });

    // MCP handshake (sequence from ollama-mcp-bridge/mcp_manager.py)
    await this._rpc(name, 'initialize', {
      protocolVersion: '2024-11-05',
      clientInfo: { name: 'salvage', version: '1.0' },
      capabilities: {},
    });
    this._notify(name, 'notifications/initialized', {});

    // Discover tools — stored as {server}.{tool} (ollama-mcp-bridge naming convention)
    const result = await this._rpc(name, 'tools/list', {});
    for (const tool of (result.tools || [])) {
      this.tools.push({
        type: 'function',
        function: {
          name: `${name}.${tool.name}`,
          description: tool.description || '',
          parameters: tool.inputSchema || { type: 'object', properties: {} },
        },
        _server: name,
        _toolName: tool.name,
      });
    }
    log(`MCP[${name}]: connected, ${(result.tools || []).length} tools`);
  }

  // Parse newline-delimited JSON messages (standard MCP stdio transport)
  // Each message is a single JSON object on its own line.
  _drainLines(name, state) {
    const lines = state.buf.split('\n');
    // Keep the last (potentially incomplete) line in the buffer
    state.buf = lines.pop();
    for (const line of lines) {
      const trimmed = line.trim();
      if (!trimmed) continue;
      let msg;
      try { msg = JSON.parse(trimmed); } catch { continue; }
      if (msg.id != null && state.pending.has(msg.id)) {
        const { resolve, reject } = state.pending.get(msg.id);
        state.pending.delete(msg.id);
        if (msg.error) reject(new Error(msg.error.message || JSON.stringify(msg.error)));
        else resolve(msg.result);
      }
    }
  }

  _write(name, msg) {
    const state = this.servers.get(name);
    if (!state) throw new Error(`MCP server ${name} not connected`);
    state.proc.stdin.write(JSON.stringify(msg) + '\n');
  }

  _rpc(name, method, params, timeoutMs = 30000) {
    const state = this.servers.get(name);
    if (!state) return Promise.reject(new Error(`MCP server ${name} not connected`));
    const id = state.nextId++;
    return new Promise((resolve, reject) => {
      const timer = setTimeout(() => {
        state.pending.delete(id);
        reject(new Error(`MCP RPC timeout: ${method} on ${name}`));
      }, timeoutMs);
      state.pending.set(id, {
        resolve: v => { clearTimeout(timer); resolve(v); },
        reject: e => { clearTimeout(timer); reject(e); },
      });
      this._write(name, { jsonrpc: '2.0', id, method, params });
    });
  }

  _notify(name, method, params) {
    try { this._write(name, { jsonrpc: '2.0', method, params }); } catch {}
  }

  async callTool(fullName, args) {
    // memory_search / salvage_memory_search: direct binary call — fast, no MCP overhead
    // Accept both names: 'memory_search' (internal) and 'salvage_memory_search' (SOUL.md name)
    if (fullName === 'memory_search' || fullName === 'salvage_memory_search') {
      try {
        return execFileSync(
          path.join(HOME, 'bin/salvage-memory-search'),
          [WORKSPACE, args.query || ''],
          { timeout: 30000, encoding: 'utf-8', env: process.env }
        ).trim() || '(no results)';
      } catch (e) { return `memory_search error: ${e.message}`; }
    }

    let toolDef = this.tools.find(t => t.function.name === fullName);
    if (!toolDef) {
      // Fuzzy fallback: Gemma 4 hallucinates tool names (e.g. "google:ds_engine/file_read").
      // Map intent-signals in the hallucinated name to real filesystem tools.
      // This is intentional leniency — a wrong name with correct args is better than an error.
      const lower = fullName.toLowerCase();
      let fallbackName;
      if (lower.includes('write') || lower.includes('save') || lower.includes('put') || lower.includes('creat')) {
        fallbackName = 'filesystem.write_file';
      } else if (lower.includes('edit') || lower.includes('patch') || lower.includes('modif') || lower.includes('replac')) {
        fallbackName = 'filesystem.edit_file';
      } else if (lower.includes('list') || lower.includes('dir') || lower.includes('ls')) {
        fallbackName = 'filesystem.list_directory';
      } else if (lower.includes('read') || lower.includes('load') || lower.includes('get') || lower.includes('open') || lower.includes('file')) {
        fallbackName = 'filesystem.read_file';
      } else if (lower.includes('search') || lower.includes('find') || lower.includes('query')) {
        fallbackName = 'google-ai-search.search_ai';
      }
      if (fallbackName) {
        toolDef = this.tools.find(t => t.function.name === fallbackName);
        if (toolDef) log(`callTool: fuzzy-mapped "${fullName}" → "${fallbackName}"`);
      }
    }
    if (!toolDef) return `Unknown tool: ${fullName}`;

    try {
      const result = await this._rpc(toolDef._server, 'tools/call', {
        name: toolDef._toolName,
        arguments: args,
      }, 60000);
      const content = result?.content;
      if (!content?.length) return '(tool returned no content)';
      const first = content[0];
      if (first.text) return first.text;
      if (first.data) return typeof first.data === 'string' ? first.data : JSON.stringify(first.data);
      return JSON.stringify(first);
    } catch (e) { return `Tool error (${fullName}): ${e.message}`; }
  }

  cleanup() {
    for (const [, state] of this.servers) {
      try { state.proc.kill('SIGTERM'); } catch {}
    }
    this.servers.clear();
    this.tools = [];
  }
}

// ── detectBackend ─────────────────────────────────────────────────────────
// CLI-based detection — no port guessing, no false positives from unrelated servers.
//
// mlx-lm:  pgrep -af mlx_lm.server  → find process, parse --port from args
//           then canary HTTP tool call to verify parser works for this model
// Ollama:  execFileSync('ollama', ['show', model]) → confirms model installed + daemon alive
//
// Source for canary approach: mlx-lm Issue #1096 — Gemma 4 <|tool_call> token format
// not handled by _infer_tool_parser() → tool_calls silently null regardless of model quality.
// Gemma 4 in MLX_BROKEN_TOOL_FAMILIES skips directly to Ollama without canary.
const MLX_BROKEN_TOOL_FAMILIES = ['gemma4', 'gemma-4', 'gemma 4'];

async function detectBackend(model) {
  const http = require('http');
  const { execSync } = require('child_process');

  // Find mlx_lm.server process and extract its --port arg
  function findMlxServer() {
    try {
      // Use ps + grep instead of pgrep -af to avoid self-match false positives
      const out = execSync('ps aux | grep "[m]lx_lm.server"', { encoding: 'utf-8', timeout: 2000, shell: true }).trim();
      if (!out) return null;
      const portMatch = out.match(/--port[=\s]+(\d+)/);
      const port = portMatch ? parseInt(portMatch[1]) : 8080; // default mlx-lm port
      log(`detectBackend: mlx_lm.server process found on port ${port}`);
      return port;
    } catch { return null; }
  }

  // Canary: send a minimal tool-call request, check if tool_calls comes back populated.
  // Only run this after confirming the right mlx-lm process exists.
  async function canaryToolCall(port, model) {
    const body = JSON.stringify({
      model,
      messages: [{ role: 'user', content: 'Call get_time.' }],
      tools: [{ type: 'function', function: {
        name: 'get_time', description: 'Get current time',
        parameters: { type: 'object', properties: {} },
      }}],
      stream: false, max_tokens: 50,
    });
    return new Promise(resolve => {
      const req = http.request({
        hostname: '127.0.0.1', port, path: '/v1/chat/completions', method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body) },
      }, res => {
        let data = '';
        res.on('data', c => data += c);
        res.on('end', () => {
          try {
            const p = JSON.parse(data);
            const calls = p?.choices?.[0]?.message?.tool_calls;
            resolve(Array.isArray(calls) && calls.length > 0);
          } catch { resolve(false); }
        });
      });
      req.setTimeout(8000, () => { req.destroy(); resolve(false); });
      req.on('error', () => resolve(false));
      req.write(body); req.end();
    });
  }

  // Check Ollama has this model installed and daemon is alive
  function checkOllama(model) {
    try {
      execSync(`ollama show ${model}`, {
        encoding: 'utf-8', timeout: 5000,
        env: { ...process.env, PATH: '/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin' },
      });
      return true;
    } catch { return false; }
  }

  const modelLower = (model || '').toLowerCase();
  const mlxBroken = MLX_BROKEN_TOOL_FAMILIES.some(f => modelLower.includes(f));

  // 1. mlx-lm — process-based detection, not port-based
  const mlxPort = findMlxServer();
  if (mlxPort !== null) {
    if (mlxBroken) {
      log(`detectBackend: mlx-lm running but ${model} in broken tool family list — falling through`);
    } else {
      const ok = await canaryToolCall(mlxPort, model);
      if (ok) {
        log(`detectBackend: mlx-lm port ${mlxPort} selected (canary verified)`);
        return { type: 'mlx', port: mlxPort };
      }
      log(`detectBackend: mlx-lm running but canary failed for ${model} — falling through`);
    }
  }

  // 2. Ollama — CLI check confirms model exists and daemon is responsive
  if (checkOllama(model)) {
    log('detectBackend: Ollama selected (model confirmed via ollama show)');
    return { type: 'ollama', port: 11434 };
  }

  // 3. OpenAI-compatible external API — Qwen, Together, Groq, Fireworks, etc.
  // Config sources (checked in order):
  //   a) workspace salvage.json → { "apiEndpoint": "...", "apiKey": "..." }
  //   b) ~/.salvage/config.json (same keys)
  //   c) env: OPENAI_BASE_URL + OPENAI_API_KEY (OpenAI-standard convention)
  //   d) env: TOGETHER_API_KEY → Together AI endpoint
  //   e) env: GROQ_API_KEY → Groq endpoint
  const apiEndpoint =
    config.apiEndpoint ||
    process.env.OPENAI_BASE_URL ||
    (process.env.TOGETHER_API_KEY ? 'https://api.together.xyz/v1' : null) ||
    (process.env.GROQ_API_KEY ? 'https://api.groq.com/openai/v1' : null);
  const apiKey =
    config.apiKey ||
    process.env.OPENAI_API_KEY ||
    process.env.TOGETHER_API_KEY ||
    process.env.GROQ_API_KEY;

  if (apiEndpoint && apiKey) {
    log(`detectBackend: openai_compat selected — endpoint=${apiEndpoint}`);
    return { type: 'openai_compat', endpoint: apiEndpoint, apiKey };
  }

  throw new Error(
    `No backend available for model "${model}". Options:\n` +
    `  Local:   Install Ollama and run: ollama pull ${model}\n` +
    `  API:     Set OPENAI_BASE_URL + OPENAI_API_KEY in env, or add apiEndpoint/apiKey to salvage.json`
  );
}

// ── callLLM ───────────────────────────────────────────────────────────────
// Unified API-family entry point for non-Claude models (mlx-lm + Ollama).
// Owns the full MCP agentic loop. Returns {code, stdout, stderr} like callClaude.
// Architecture sources: ollama-mcp-bridge/proxy_service.py (loop),
//   AnythingLLM/ollama.js (supportsNativeToolCalling → UnTooled fallback),
//   Cline/ollama-format.ts (format differences).
function truncateToolResult(text, maxChars = 40000) {
  if (text.length <= maxChars) return text;
  const head = 30000;
  const tail = 5000;
  const omitted = text.length - head - tail;
  return text.slice(0, head)
    + `\n\n[... ${omitted} chars omitted — middle of tool result truncated to fit context ...]\n\n`
    + text.slice(text.length - tail);
}

// correctionInstruction: injected by outerRetryLoop on recovery attempts (planning-only, empty, exhausted).
async function callLLM(model, userPrompt, mcpManager, correctionInstruction = null) {
  let backend;
  try { backend = await detectBackend(model); }
  catch (e) { return { code: 1, stdout: '', stderr: e.message, meta: { roundsUsed: 0, finalAnswerProduced: false, toolCallsMade: 0, planningOnly: false, emptyResponse: true } }; }

  // Workspace context cap: capable API models get more context than weak local models.
  // Gemma/small local: 2KB cap (avoids Claude identity confusion + skill XML noise).
  // openai_compat + mlx-verified: 10KB cap (still excludes raw skill XML but includes persona).
  const isCapableBackend = backend.type === 'openai_compat' || backend.type === 'mlx';
  const workspacePromptCap = isCapableBackend ? 10000 : 2000;
  const workspacePrompt = (() => {
    try {
      const full = fs.readFileSync(tmpFile, 'utf-8');
      return full.length > workspacePromptCap
        ? full.slice(0, workspacePromptCap) + '\n...(context truncated for LLM)'
        : full;
    } catch { return ''; }
  })();

  // Tool list: memory_search (direct binary, always available) + real MCP tools
  const MEMORY_TOOL = {
    type: 'function',
    function: {
      name: 'salvage_memory_search',
      description: 'Search YOUR personal memory (salvage-memory-search). This is your memory store containing past conversations, people you know, projects, and decisions. Call this whenever asked to "remember", "recall", "search your memory", or look up something from a previous session.',
      parameters: { type: 'object', properties: { query: { type: 'string', description: 'Search query' } }, required: ['query'] },
    },
  };
  // Tool cap: weak UnTooled models (Gemma) break with too many tools — schemas inflate context.
  // Capable models (openai_compat, mlx-verified) handle the full tool list natively.
  const UNTOOLED_FIRST_MODELS = ['gemma4', 'gemma-4', 'gemma 4'];
  const isUnTooledFirst = UNTOOLED_FIRST_MODELS.some(m => model.toLowerCase().includes(m));
  const LOCAL_LLM_MAX_TOOLS = 8;
  const allTools = [MEMORY_TOOL, ...mcpManager.tools];
  const rawTools = (isUnTooledFirst && allTools.length > LOCAL_LLM_MAX_TOOLS)
    ? allTools.slice(0, LOCAL_LLM_MAX_TOOLS)
    : allTools;
  if (isUnTooledFirst && allTools.length > LOCAL_LLM_MAX_TOOLS) {
    log(`callLLM: trimmed tools ${allTools.length} → ${rawTools.length} (UnTooled cap)`);
  }

  // Normalize tool names for local LLMs: OpenAI spec only allows [a-zA-Z0-9_-] in tool names.
  // Dots (e.g. "filesystem.read_file") are illegal — Gemma ignores these and hallucinates tool names.
  // Replace dots with underscores and keep a reverse map for routing real MCP calls.
  // Source: OpenAI Function calling spec, tool name regex ^[a-zA-Z0-9_-]{1,64}$
  const toolNameMap = {}; // normalized → original
  const tools = rawTools.map(t => {
    const origName = t.function.name;
    const normName = origName.replace(/\./g, '_');
    if (normName !== origName) toolNameMap[normName] = origName;
    return { ...t, function: { ...t.function, name: normName } };
  });
  log(`callLLM: normalized tool names: ${Object.keys(toolNameMap).join(', ') || '(none needed)'}`);

  // Tool instructions go FIRST — local models have small context windows and de-prioritize end-of-prompt content
  // Short name list only (descriptions are already in the tool schemas passed to Ollama API).
  // Long tool descriptions in the system prompt inflate token count and confuse small models.
  const toolNames = tools.map(t => t.function.name).join(', ');
  // Identity override FIRST — the workspace prompt was written for Claude and contains Claude identity
  // instructions (e.g. "Claude Sonnet = default"). Without an explicit override, local models will
  // impersonate Claude and refuse tool calls (thinking they are Claude with no tool access).
  const toolInstructions = [
    `## Runtime identity`,
    `You are ${model}, a local AI running via Ollama with native tool calling. You are NOT Claude.`,
    `Ignore any references to Claude models, Claude identity, or Claude-specific behaviors in the context below.`,
    ``,
    `## Tool use — MANDATORY`,
    `Your registered tools are: ${toolNames}`,
    `These are the ONLY valid tool names. Do NOT call any other name. Never call "google:*", "tool_code", "code_execution", or any made-up name.`,
    `USE THEM. Never claim you lack access if a tool exists for the request.`,
    `RULE: For any request to read, write, modify, search, look up, send, or act on anything — call the appropriate tool IMMEDIATELY.`,
    ``,
    `## CRITICAL: Act first, talk later`,
    `When given a task that involves files, data, or external systems:`,
    `- Your FIRST output MUST be a tool call — NOT a description, NOT a plan, NOT "I will do X".`,
    `- Do not explain what you are going to do. Just do it.`,
    `- Call tools in sequence until the task is complete.`,
    `- Only send a final text message AFTER all tool calls are done.`,
    `- If you respond with text before calling any tools on an action task, your response is WRONG.`,
    ``,
    `## IMPORTANT: Do NOT read SOUL.md, USER.md, TOOLS.md, IDENTITY.md, COMPANY.md, TEAM.md, SLACK.md, NOTION.md, AGENTS.md, HEARTBEAT.md, or MEMORY.md.`,
    `These workspace context files are already included in this system prompt. Reading them again wastes turns.`,
    `The ONLY files you should read are the target files specified in the user's task.`,
    `---`, ``,
  ].join('\n');
  const systemPrompt = toolInstructions + workspacePrompt;

  log(`callLLM: model=${model} backend=${backend.type}:${backend.port} tools=${tools.length}`);

  function httpPost(port, urlPath, body, timeoutMs = 120000) {
    return new Promise((resolve, reject) => {
      const bodyStr = JSON.stringify(body);
      const req = require('http').request({
        hostname: '127.0.0.1', port, path: urlPath, method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(bodyStr) },
      }, res => {
        let data = '';
        res.on('data', c => data += c);
        res.on('end', () => {
          try { resolve(JSON.parse(data)); }
          catch (e) { reject(new Error(`LLM parse error: ${data.slice(0, 200)}`)); }
        });
      });
      req.setTimeout(timeoutMs, () => { req.destroy(); reject(new Error('LLM request timed out')); });
      req.on('error', reject);
      req.write(bodyStr);
      req.end();
    });
  }

  // Normalize raw HTTP response → { text, tool_calls: [{id, name, args}] }
  // Format split: mlx-lm uses OpenAI choices[]; Ollama uses message{}
  function normalizeResponse(raw) {
    if (backend.type === 'mlx') {
      const msg = raw?.choices?.[0]?.message || {};
      return {
        text: msg.content || '',
        tool_calls: (msg.tool_calls || []).map(tc => ({
          id: tc.id,
          name: tc.function?.name,
          args: (() => {
            try { return typeof tc.function?.arguments === 'string'
              ? JSON.parse(tc.function.arguments) : (tc.function?.arguments || {}); }
            catch { return {}; }
          })(),
        })),
      };
    } else {
      if (raw.error) throw new Error(raw.error);
      const msg = raw.message || {};
      return {
        text: msg.content || '',
        tool_calls: (msg.tool_calls || []).map(tc => ({
          id: null,
          name: tc.function?.name,
          args: (() => {
            try { return typeof tc.function?.arguments === 'string'
              ? JSON.parse(tc.function.arguments) : (tc.function?.arguments || {}); }
            catch { return {}; }
          })(),
        })),
      };
    }
  }

  // HTTP POST to an external HTTPS/HTTP endpoint (for openai_compat backends).
  function httpPostRemote(url, body, headers = {}, timeoutMs = 120000) {
    return new Promise((resolve, reject) => {
      const { URL } = require('url');
      const parsed = new URL(url);
      const isHttps = parsed.protocol === 'https:';
      const transport = require(isHttps ? 'https' : 'http');
      const bodyStr = JSON.stringify(body);
      const allHeaders = {
        'Content-Type': 'application/json',
        'Content-Length': Buffer.byteLength(bodyStr),
        ...headers,
      };
      const req = transport.request({
        hostname: parsed.hostname,
        port: parsed.port || (isHttps ? 443 : 80),
        path: parsed.pathname + (parsed.search || ''),
        method: 'POST',
        headers: allHeaders,
      }, res => {
        let data = '';
        res.on('data', c => data += c);
        res.on('end', () => {
          try { resolve(JSON.parse(data)); }
          catch (e) { reject(new Error(`Remote API parse error: ${data.slice(0, 300)}`)); }
        });
      });
      req.setTimeout(timeoutMs, () => { req.destroy(); reject(new Error('Remote API request timed out')); });
      req.on('error', reject);
      req.write(bodyStr);
      req.end();
    });
  }

  async function providerChat(msgs, toolList) {
    if (backend.type === 'openai_compat') {
      // OpenAI-compatible API (Qwen, Together, Groq, etc.) — native tool calling, no UnTooled needed.
      const raw = await httpPostRemote(
        backend.endpoint.replace(/\/$/, '') + '/chat/completions',
        { model, messages: msgs, stream: false, tools: toolList.length ? toolList : undefined, tool_choice: toolList.length ? 'auto' : undefined },
        { 'Authorization': `Bearer ${backend.apiKey}` },
        180000, // 3 min timeout for external APIs
      );
      return normalizeResponse(raw);
    } else if (backend.type === 'mlx') {
      const raw = await httpPost(backend.port, '/v1/chat/completions', {
        model, messages: msgs, stream: false,
        tools: toolList.length ? toolList : undefined,
      });
      return normalizeResponse(raw);
    } else {
      const body = { model, messages: msgs, stream: false, tools: toolList.length ? toolList : undefined, keep_alive: OLLAMA_KEEP_ALIVE };
      const raw = await httpPost(backend.port, '/api/chat', body);
      return normalizeResponse(raw);
    }
  }

  // Tool result message format differs by backend
  // Source: Cline/ollama-format.ts (role:"user" fallback), ollama-mcp-bridge (role:"tool")
  function toolResultMsg(call, result) {
    if (backend.type === 'mlx') {
      return { role: 'tool', tool_call_id: call.id || 'call_0', content: result };
    } else {
      return { role: 'tool', tool_name: call.name, content: result };
    }
  }

  // ── Native tool-calling agentic loop ─────────────────────────────────
  // Source: ollama-mcp-bridge/proxy_service.py:103-145, AnythingLLM/aibitat/index.js:886
  // Strategy: always inject tools (never hard-block on capability check).
  // Empty tool_calls = model answered directly or doesn't support tool calling.

  // If outerRetryLoop injected a correction, prepend it to the user prompt.
  const effectiveUserPrompt = correctionInstruction
    ? `${correctionInstruction}\n\n---\n\n${userPrompt}`
    : userPrompt;

  const messages = [
    { role: 'system', content: systemPrompt },
    { role: 'user', content: effectiveUserPrompt },
  ];
  const MAX_ROUNDS = 20; // Raised from 8 — complex tasks (multi-file refactors) need more turns
  let finalText = '';
  // Gemma 4's native tool calling is unreliable — skip to UnTooled grammar-constrained mode.
  // isUnTooledFirst + isCapableBackend already set above from the same UNTOOLED_FIRST_MODELS list.
  let unTooledMode = isUnTooledFirst;
  // Planning-only detection: matches responses that describe what will be done without doing it.
  // Source: OpenClaw agent runtime PLANNING_ONLY_PROMISE_RE pattern (openclaw dist, ~line 33237).
  const PLANNING_ONLY_RE = /\b(i['']ll|i will|let me|going to|i'm going|i can do|i would|here['']s how|here is how|first[,\s]+i['']ll|next[,\s]+i['']ll|i['']d like to|i need to|i should)\b/i;
  const PLANNING_DONE_RE = /\b(done|finished|complete|saved|written|modified|updated|here['']s the|here is the)\b/i;
  let planningRetryUsed = false;

  // Meta: outcome classification for outerRetryLoop
  const meta = { roundsUsed: 0, finalAnswerProduced: false, toolCallsMade: 0, planningOnly: false, emptyResponse: false, sentProgressUpdates: 0 };

  // For UnTooled-first models (Gemma 4), skip the native tool loop entirely
  if (isUnTooledFirst) {
    log('callLLM: UnTooled-first model — skipping native loop, going straight to UnTooled fallback');
  }

  for (let round = 0; !isUnTooledFirst && round < MAX_ROUNDS; round++) {
    meta.roundsUsed = round + 1;
    let response;
    try { response = await providerChat(messages, unTooledMode ? [] : tools); }
    catch (e) { return { code: 1, stdout: '', stderr: e.message, meta }; }

    const { text, tool_calls } = response;

    if (!text?.trim() && !tool_calls.length) meta.emptyResponse = true;

    if (!tool_calls.length) {
      if (tools.length > 0 && !planningRetryUsed && PLANNING_ONLY_RE.test(text) && !PLANNING_DONE_RE.test(text)) {
        // Planning-only response detected (OpenClaw approach): inject retry instruction.
        log(`callLLM: planning-only turn detected (round=${round}) — injecting retry instruction`);
        meta.planningOnly = true;
        planningRetryUsed = true;
        messages.push({ role: 'assistant', content: text });
        messages.push({ role: 'user', content: 'The previous turn only described the plan. Do not restate the plan. Act now: take the first concrete tool action you can. If a real blocker prevents action, reply with the exact blocker in one sentence.' });
        continue;
      }
      if (round === 0 && tools.length > 0 && !text.trim()) {
        // Empty response on round 0 → switch to UnTooled mode
        log('callLLM: empty response round 0 — switching to UnTooled mode');
        unTooledMode = true;
        continue;
      }
      if (planningRetryUsed && !tool_calls.length) {
        // Retry also produced no tool calls → grammar-constrained UnTooled fallback
        log('callLLM: planning retry failed — switching to UnTooled mode');
        unTooledMode = true;
        break;
      }
      finalText = text;
      break;
    }

    // Append assistant turn (format differs by backend)
    if (backend.type === 'mlx') {
      messages.push({ role: 'assistant', content: text || null, tool_calls: tool_calls.map((tc, i) => ({
        id: tc.id || `call_${i}`, type: 'function',
        function: { name: tc.name, arguments: JSON.stringify(tc.args) },
      }))});
    } else {
      messages.push({ role: 'assistant', content: text, tool_calls: tool_calls.map(tc => ({
        function: { name: tc.name, arguments: tc.args },
      }))});
    }

    // Execute each tool via MCPClientManager
    for (const call of tool_calls) {
      meta.toolCallsMade++;
      // Reverse-map normalized name (underscores) back to original MCP name (dots)
      const realName = toolNameMap[call.name] || call.name;
      log(`callLLM[round=${round}]: ${call.name}→${realName}(${JSON.stringify(call.args).slice(0, 120)})`);
      let result = await mcpManager.callTool(realName, call.args);
      result = truncateToolResult(result);
      log(`callLLM: result: ${result.slice(0, 120)}`);
      // Inject correction on tool failures — tell the model exactly how to fix the call
      const isFailed = result.startsWith('Unknown tool:') || result.startsWith('Tool error:') ||
                       result.startsWith('MCP error') || result.includes('Access denied') ||
                       result.includes('outside allowed directories');
      if (isFailed) {
        result += `\n\nCORRECTION: The tool call failed. Your valid tools are: ${toolNames}\nFilesystem tools require absolute paths. The correct username is "jayden.csai" (not "jayden").\nUse the "path" parameter (not "file_path").\nExample: filesystem_read_file with {"path": "/Users/jayden.csai/bin/voice-bubble.py"}\nDo NOT call "google:*", "tool_code", or any made-up name.`;
      }
      messages.push(toolResultMsg(call, result));
    }
  }

  // ── UnTooled fallback ─────────────────────────────────────────────────
  // Source: AnythingLLM/untooled.js — prompt-inject tool catalog + grammar-constrained output.
  // Uses Ollama's format field (JSON Schema) to enforce syntactic structure.
  if (unTooledMode || !finalText) {
    log('callLLM: entering UnTooled fallback');
    const toolCatalog = tools.map(t =>
      `- ${t.function.name}: ${t.function.description}\n  args: ${JSON.stringify(t.function.parameters?.properties || {})}`
    ).join('\n');

    // Detect if Slack reply tools are available (for 随時報告 guidance)
    const hasSlackReply = tools.some(t => t.function.name === 'slack_reply_to_thread');
    const progressSection = hasSlackReply ? [
      '',
      '## Progress reporting (随時報告)',
      'For tasks requiring more than ~4 tool calls:',
      '- After every 3–4 tool calls, send a brief progress update to the user via slack_reply_to_thread.',
      '- Use the same channel and thread_ts that the user\'s message came from (check your context/session for these values).',
      '- Keep progress messages short: one line describing what you just completed and what you are doing next.',
      '- Example: {"name":"slack_reply_to_thread","arguments":{"channel":"C123","thread_ts":"123.456","text":"✅ ステップ1完了。次はXXXを確認します。"}}',
      '- After all work is done, your final_answer should be a brief completion summary — do NOT repeat everything you already reported.',
    ] : [];

    const unTooledSystem = systemPrompt + [
      '', '---', '## Tool calling format',
      'Available tools:', toolCatalog, '',
      'To call a tool, output ONLY valid JSON: {"name":"tool_name","arguments":{...}}',
      'To give your final answer, output ONLY valid JSON: {"name":"final_answer","arguments":{"text":"your response"}}',
      ...progressSection,
    ].join('\n');

    // Prepend a hard override to the user prompt: force tool calls before text.
    // The WORKER_MODE text ("write your complete response as plain text") causes Gemma
    // to output final_answer immediately. This override must appear BEFORE WORKER_MODE content.
    // Cold-start prompt: force at least one tool call before answering.
    const unTooledUserPrompt = [
      `[INSTRUCTION OVERRIDE — takes precedence over all other instructions]`,
      `You MUST call at least one tool before outputting final_answer.`,
      `Output {"name":"final_answer","arguments":{"text":"..."}} ONLY after completing all tool calls.`,
      `Do NOT output final_answer as your first response. Call a tool first.`,
      `---`,
      userPrompt,
    ].join('\n');

    // Restored-session prompt: Gemma already has prior tool context — let her answer directly.
    const restoredUserPrompt = [
      `[CONTINUATION — prior session context is above]`,
      `You have prior tool call results in your context. Answer directly if you already have the information.`,
      `If more information is needed to answer, call a tool first. Otherwise output final_answer.`,
      `---`,
      userPrompt,
    ].join('\n');

    let unTooledMsgs = [
      { role: 'system', content: unTooledSystem },
      { role: 'user', content: unTooledUserPrompt },
    ];

    // ── Session persistence (thread-keyed) ───────────────────────────────
    const SESSION_DIR = path.join(HOME, '.salvage', 'sessions');
    const SESSION_TTL_MS = 2 * 60 * 60 * 1000; // 2 hours
    fs.mkdirSync(SESSION_DIR, { recursive: true });
    const sessionFile = threadTs
      ? path.join(SESSION_DIR, `${threadTs.replace(/\./g, '_')}.json`)
      : null;

    let isRestored = false; // true when a prior session was loaded

    // Compact a session that has grown too large by summarizing the middle turns.
    // Keeps: system prompt, last KEEP_RECENT pairs verbatim, new user message.
    // Summarizes everything in between using a fast Gemma call (same model, no subworker).
    const SESSION_COMPACT_CHARS = 80000; // ~23K tokens — trigger threshold
    const KEEP_RECENT_PAIRS = 3;         // verbatim pairs (assistant+user) to preserve at tail

    async function compactSessionMsgs(msgs, newUserMsg) {
      const systemMsg = msgs[0]; // always index 0
      const history = msgs.slice(1); // everything after system

      // Keep the last KEEP_RECENT_PAIRS * 2 messages verbatim
      const keepN = KEEP_RECENT_PAIRS * 2;
      const toSummarize = history.slice(0, Math.max(0, history.length - keepN));
      const recent = history.slice(Math.max(0, history.length - keepN));

      if (toSummarize.length === 0) {
        // Nothing to compact — just append new message
        msgs.push(newUserMsg);
        return msgs;
      }

      // Format the history to summarize as a readable transcript
      const transcript = toSummarize.map(m => `[${m.role.toUpperCase()}]\n${m.content}`).join('\n\n');
      const summarizePrompt = [
        'You are a precise summarizer. Summarize the following conversation transcript in 200 words or fewer.',
        'Preserve: all filenames, paths, function names, decisions made, errors found, and what was completed.',
        'Do NOT include tool JSON syntax. Write plain prose.',
        '---',
        transcript,
        '---',
        'Summary:',
      ].join('\n');

      log(`callLLM[session]: compacting — summarizing ${toSummarize.length} msgs (${transcript.length} chars)`);
      let summary = '[Prior context summary unavailable]';
      try {
        if (backend.type === 'ollama') {
          const raw = await httpPost(backend.port, '/api/chat', {
            model,
            messages: [{ role: 'user', content: summarizePrompt }],
            stream: false,
            keep_alive: OLLAMA_KEEP_ALIVE,
            options: { temperature: 0.1 }, // num_predict omitted — causes blank output in Gemma 4
          }, 60000); // 60s timeout for summary
          summary = raw?.message?.content?.trim() || summary;
        }
        log(`callLLM[session]: compaction done — summary: ${summary.slice(0, 120)}`);
      } catch (e) {
        log(`callLLM[session]: compaction failed — ${e.message}, falling back to drop`);
        // Fallback: just drop the old messages rather than failing the whole job
      }

      return [
        systemMsg,
        { role: 'user', content: `[PRIOR CONTEXT SUMMARY — ${toSummarize.length} turns compacted]\n${summary}` },
        { role: 'assistant', content: 'Understood. Continuing from prior context.' },
        ...recent,
        newUserMsg,
      ];
    }

    if (sessionFile && fs.existsSync(sessionFile)) {
      try {
        const saved = JSON.parse(fs.readFileSync(sessionFile, 'utf8'));
        const age = Date.now() - saved.savedAt;
        if (age < SESSION_TTL_MS) {
          unTooledMsgs = saved.msgs;
          // Refresh system prompt (tool catalog may have changed between invocations)
          if (unTooledMsgs.length > 0 && unTooledMsgs[0].role === 'system') {
            unTooledMsgs[0] = { role: 'system', content: unTooledSystem };
          }
          const newUserMsg = { role: 'user', content: restoredUserPrompt };
          const sessionChars = JSON.stringify(unTooledMsgs).length;

          if (sessionChars > SESSION_COMPACT_CHARS) {
            // Session too large — summarize old turns before appending new message
            log(`callLLM[session]: session ${Math.round(sessionChars / 1024)}KB exceeds ${Math.round(SESSION_COMPACT_CHARS / 1024)}KB — compacting`);
            unTooledMsgs = await compactSessionMsgs(unTooledMsgs, newUserMsg);
          } else {
            // Session fits — just append (with role separator if needed)
            const lastRole = unTooledMsgs[unTooledMsgs.length - 1]?.role;
            if (lastRole === 'user') {
              unTooledMsgs.push({ role: 'assistant', content: '[Ready for next message]' });
            }
            unTooledMsgs.push(newUserMsg);
          }

          isRestored = true;
          log(`callLLM[session]: resumed thread session (${saved.msgs.length} msgs → ${unTooledMsgs.length} msgs after compact, age ${Math.round(age / 60000)}m)`);
        } else {
          fs.unlinkSync(sessionFile);
          log(`callLLM[session]: expired session deleted`);
        }
      } catch (e) {
        log(`callLLM[session]: load error — ${e.message}`);
      }
    }

    // Use enum for the name field so Ollama's grammar engine is forced to pick
    // a real tool name (or "final_answer"). Without enum, Ollama may produce
    // JSON without a name field at all (required[] not strictly enforced).
    // On round 0 of a COLD start: exclude final_answer to force at least one tool call.
    // On round 0 of a RESTORED session: include final_answer — Gemma already has context
    // from prior turns and may legitimately answer without calling another tool.
    const toolOnlyEnum = tools.map(t => t.function.name);
    const toolPlusFinalEnum = [...toolOnlyEnum, 'final_answer'];

    for (let round = 0; round < MAX_ROUNDS; round++) {
      meta.roundsUsed = round + 1;

      // Mid-task context guard: compact if session is growing too large mid-task
      if (round > 0) {
        const midCtxSize = JSON.stringify(unTooledMsgs).length;
        if (midCtxSize > 100000) {
          log(`callLLM[UnTooled]: context ${Math.round(midCtxSize / 1024)}KB — compacting mid-task (round ${round})`);
          unTooledMsgs = await compactSessionMsgs(unTooledMsgs, null);
        }
      }

      // Restored sessions allow final_answer on round 0; cold starts must call a tool first
      const currentEnum = (round === 0 && !isRestored) ? toolOnlyEnum : toolPlusFinalEnum;
      const unTooledSchema = {
        type: 'object',
        properties: {
          name: { type: 'string', enum: currentEnum },
          arguments: { type: 'object' },
        },
        required: ['name', 'arguments'],
      };
      let text;
      try {
        if (backend.type === 'ollama') {
          const raw = await httpPost(backend.port, '/api/chat', {
            model, messages: unTooledMsgs, stream: false,
            keep_alive: OLLAMA_KEEP_ALIVE,
            format: unTooledSchema, options: { temperature: 0.1 },
          });
          text = raw?.message?.content || '';
        } else {
          const resp = await providerChat(unTooledMsgs, []);
          text = resp.text;
        }
      } catch (e) { finalText = `[UnTooled error: ${e.message}]`; break; }

      log(`callLLM[UnTooled raw round=${round}]: ${(text || '').slice(0, 200)}`);

      // Strip markdown code fences — Gemma 4 wraps JSON in ```json...``` even with grammar constraints
      const cleanText = (text || '').replace(/^```(?:json)?\s*/im, '').replace(/\s*```\s*$/m, '').trim();

      let parsed;
      try { parsed = JSON.parse(cleanText); }
      catch (e) {
        if (round > 0) {
          // After at least one tool call, plain text is a valid final answer — accept it directly
          log(`callLLM[UnTooled]: plain-text final answer after ${round} tool round(s)`);
          finalText = text;
        } else {
          log(`callLLM[UnTooled parse error]: ${e.message} — text="${(text||'').slice(0,100)}"`);
          finalText = text;
        }
        break;
      }

      // Normalize field names — Gemma uses many different formats:
      //   {"name":"X","arguments":{}}  — canonical
      //   {"tool_name":"X","parameters":{}} — common variant
      //   {"tool_calls":[{"function":"X","args":{}}]} — OpenAI-style array
      //   [{"name":"X","arguments":{}}] — bare array
      let parsedEntry = parsed;
      if (Array.isArray(parsed) && parsed.length > 0) parsedEntry = parsed[0];
      if (parsedEntry.tool_calls && Array.isArray(parsedEntry.tool_calls) && parsedEntry.tool_calls.length > 0) {
        parsedEntry = parsedEntry.tool_calls[0];
      }
      const parsedName = parsedEntry.name || parsedEntry.tool_name || parsedEntry.function || parsedEntry.action;
      const parsedArgs = parsedEntry.arguments || parsedEntry.parameters || parsedEntry.args || parsedEntry.inputs || {};

      if (!parsedName || parsedName === 'final_answer') {
        finalText = parsedArgs.text || parsedEntry.text || parsed.text || parsed.response || cleanText;
        break;
      }

      // Resolve relative paths in args to absolute (Gemma often uses just "voice-bubble.py" or wrong subdirs)
      for (const key of ['path', 'file_path', 'filename']) {
        if (parsedArgs[key] && !parsedArgs[key].startsWith('/') && !parsedArgs[key].startsWith('~')) {
          const origVal = parsedArgs[key];
          const baseName = require('path').basename(origVal); // handle "voice-bubble/voice-bubble.py" → "voice-bubble.py"
          // Try both full relative path and basename in each candidate directory
          const searchNames = origVal === baseName ? [origVal] : [origVal, baseName];
          const searchDirs = [path.join(HOME, 'bin'), path.join(HOME, 'clawd'), path.join(HOME, 'Developer')];
          let found;
          outer: for (const name of searchNames) {
            for (const dir of searchDirs) {
              const candidate = path.join(dir, name);
              try { require('fs').accessSync(candidate); found = candidate; break outer; } catch {}
            }
          }
          if (found) { log(`callLLM[UnTooled]: resolved relative path "${origVal}" → "${found}"`); parsedArgs[key] = found; }
        }
      }

      // Normalize parameter aliases — Gemma uses file_path/filename but filesystem MCP expects path
      if (parsedArgs.file_path !== undefined && parsedArgs.path === undefined) {
        parsedArgs.path = parsedArgs.file_path;
        delete parsedArgs.file_path;
        log(`callLLM[UnTooled]: remapped file_path → path`);
      }
      if (parsedArgs.filename !== undefined && parsedArgs.path === undefined) {
        parsedArgs.path = parsedArgs.filename;
        delete parsedArgs.filename;
        log(`callLLM[UnTooled]: remapped filename → path`);
      }
      // Also remap content alias
      if (parsedArgs.content === undefined && parsedArgs.text !== undefined && parsedArgs.path !== undefined) {
        parsedArgs.content = parsedArgs.text;
        delete parsedArgs.text;
        log(`callLLM[UnTooled]: remapped text → content`);
      }

      // Tool call — execute and feed result back (reverse-map normalized name if needed)
      const realUnTooledName = toolNameMap[parsedName] || parsedName;
      log(`callLLM[UnTooled round=${round}]: ${parsedName}→${realUnTooledName}(${JSON.stringify(parsedArgs).slice(0, 120)})`);
      // Track mid-task Slack progress updates sent by the model
      if (realUnTooledName === 'slack_reply_to_thread' || realUnTooledName === 'slack_post_message') {
        meta.sentProgressUpdates++;
        log(`callLLM[UnTooled]: progress update #${meta.sentProgressUpdates} sent via ${realUnTooledName}`);
      }
      let result = await mcpManager.callTool(realUnTooledName, parsedArgs);
      result = truncateToolResult(result);
      log(`callLLM[UnTooled result]: ${result.slice(0, 120)}`);
      // Inject correction on UnTooled failures too
      if (result.startsWith('Unknown tool:') || result.includes('Access denied') || result.includes('outside allowed') ||
          result.includes('Input validation error') || result.includes('MCP error')) {
        result += `\n\nCORRECTION: The tool call failed. Retry now using: name="${realUnTooledName}", arguments={"path":"<absolute path>"}. The "path" key is required — do NOT use "file_path" or "filename". Absolute path example: /Users/jayden.csai/bin/voice-bubble.py`;
      }
      meta.toolCallsMade++;
      unTooledMsgs.push({ role: 'assistant', content: text });
      unTooledMsgs.push({ role: 'user', content: `Tool result for ${parsedName}:\n${result}` });

      // Save session after each successful tool round
      if (sessionFile) {
        try {
          fs.writeFileSync(sessionFile, JSON.stringify({ savedAt: Date.now(), msgs: unTooledMsgs }));
        } catch (e) {
          log(`callLLM[session]: save error — ${e.message}`);
        }
      }
    }

    // Save final answer inside this block (sessionFile/unTooledMsgs are in scope here).
    // Must run after the round loop so finalText is set.
    const finalAnswer = finalText || '[Model produced no response]';
    if (sessionFile) {
      try {
        unTooledMsgs.push({ role: 'assistant', content: finalAnswer });
        fs.writeFileSync(sessionFile, JSON.stringify({ savedAt: Date.now(), msgs: unTooledMsgs }));
        log(`callLLM[session]: saved final answer (${unTooledMsgs.length} msgs total)`);
      } catch (e) {
        log(`callLLM[session]: final save error — ${e.message}`);
      }
    }
  }

  const hadFinalAnswer = !!finalText;
  if (!finalText) {
    finalText = '[Model produced no response]';
    meta.emptyResponse = true;
  }
  meta.finalAnswerProduced = hadFinalAnswer;
  // If all rounds ran but no final answer, flag as exhausted (helps outerRetryLoop classify)
  if (!hadFinalAnswer && meta.roundsUsed >= MAX_ROUNDS) {
    return { code: 1, stdout: '', stderr: `Rounds exhausted after ${MAX_ROUNDS} tool calls without final answer`, meta };
  }
  return { code: hadFinalAnswer ? 0 : 1, stdout: finalText, stderr: '', meta };
}

// outerRetryLoop: wraps callLLM with OpenClaw-style recovery.
// Classifies outcomes from meta and retries with correctionInstruction when safe to do so.
async function outerRetryLoop(model, userPrompt, mcpManager) {
  const MAX_PLANNING_RETRIES  = 2; // planning-only (no tools called)
  const MAX_EMPTY_RETRIES     = 1; // empty / unparseable response
  const MAX_EXHAUSTED_RETRIES = 2; // rounds exhausted without final answer

  let planningRetries  = 0;
  let emptyRetries     = 0;
  let exhaustedRetries = 0;

  let lastResult;
  while (true) {
    let correction = null;

    // Build correction instruction based on previous failure
    if (lastResult) {
      const m = lastResult.meta || {};
      if (m.emptyResponse) {
        correction = 'Your last response was empty or could not be parsed. ' +
          'You MUST respond with a valid JSON object: {"name":"<tool_name>","arguments":{...}} ' +
          'or {"name":"final_answer","arguments":{"text":"<answer>"}}. Do not add any prose outside the JSON.';
      } else if (m.planningOnly) {
        correction = 'You have been planning or reasoning without using any tools. ' +
          'You MUST call a tool NOW before continuing. Pick the most relevant tool and call it immediately.';
      } else {
        // rounds exhausted
        correction = `You used all ${m.roundsUsed} allowed tool-call rounds without producing a final answer. ` +
          'Focus: call only the single most important tool next, then immediately respond with final_answer.';
      }
    }

    lastResult = await callLLM(model, userPrompt, mcpManager, correction);
    const m = lastResult.meta || {};

    // Success
    if (lastResult.code === 0) return lastResult;

    // Classify failure and decide whether to retry
    if (m.emptyResponse) {
      emptyRetries++;
      log(`outerRetryLoop: empty response — retry ${emptyRetries}/${MAX_EMPTY_RETRIES}`);
      if (emptyRetries > MAX_EMPTY_RETRIES) break;
      continue;
    }

    if (m.planningOnly) {
      planningRetries++;
      log(`outerRetryLoop: planning-only — retry ${planningRetries}/${MAX_PLANNING_RETRIES}`);
      if (planningRetries > MAX_PLANNING_RETRIES) break;
      continue;
    }

    // rounds exhausted
    exhaustedRetries++;
    log(`outerRetryLoop: rounds exhausted — retry ${exhaustedRetries}/${MAX_EXHAUSTED_RETRIES}`);
    if (exhaustedRetries > MAX_EXHAUSTED_RETRIES) break;
  }

  // All retries spent — return last result (code 1)
  log(`outerRetryLoop: all retries exhausted, returning last failure`);
  return lastResult;
}

function callClaude(attempt = 1) {
  return new Promise((resolve, reject) => {
    const claudeArgs = buildClaudeArgs();

    log(`Calling claude (attempt ${attempt}, task=${taskType}, workspace=${path.basename(WORKSPACE)}, session=${sessionKey || 'none'}, prompt=${systemPromptWithRecovery.length} chars)`);

    const child = spawn(CLAUDE_BIN, claudeArgs, {
      stdio: ['inherit', 'pipe', 'pipe'],
      env: buildEnv(),
      cwd: WORKSPACE,
    });

    activeClaudeChild = child;

    let stdout = '';
    let stderr = '';
    child.stdout.on('data', d => {
      const chunk = d.toString();
      stdout += chunk;
      process.stdout.write(chunk);
    });
    child.stderr.on('data', d => {
      const chunk = d.toString();
      stderr += chunk;
      process.stderr.write(chunk);
    });

    child.on('close', code => {
      activeClaudeChild = null;
      resolve({ code, stdout, stderr });
    });
    child.on('error', err => {
      activeClaudeChild = null;
      reject(err);
    });
  });
}

function isRateLimited(stderr) {
  const lower = (stderr || '').toLowerCase();
  return lower.includes('rate limit') || lower.includes('429') || lower.includes('too many requests');
}

function sleep(ms) {
  return new Promise(r => setTimeout(r, ms));
}

async function appendDailyNote(userPrompt) {
  const today = dateStr(0);
  const memDir = path.join(WORKSPACE, 'memory');
  fs.mkdirSync(memDir, { recursive: true });
  const noteFile = path.join(memDir, `${today}.md`);
  const time = nowTimeStr();
  const summary = (userPrompt || '').slice(0, 100).replace(/\n/g, ' ');

  let existing = '';
  try { existing = fs.readFileSync(noteFile, 'utf-8'); } catch {}
  if (!existing) existing = `# ${today}\n\n`;

  const entry = `- [${time}] task=${taskType} — ${summary}\n`;
  fs.writeFileSync(noteFile, existing + entry);
}

// ── Main (with Preflight + Failover Cascade) ────────────────────────────
async function main() {
  // Propagate SIGTERM to active claude child so it doesn't orphan when
  // salvage-tools (or any parent) kills this process on timeout.
  process.on('SIGTERM', () => {
    if (activeClaudeChild && !activeClaudeChild.killed) {
      activeClaudeChild.kill('SIGTERM');
      setTimeout(() => { try { activeClaudeChild.kill('SIGKILL'); } catch {} }, 3000);
    }
    process.exit(1);
  });

  try {
    // ── Tier 0: Preflight Validation ─────────────────────────────────
    const preflightIssues = runPreflightChecks();
    if (preflightIssues.length > 0) {
      for (const issue of preflightIssues) log(`PREFLIGHT: ${issue}`);
      // Re-check after auto-fix attempts
      const remaining = runPreflightChecks();
      if (remaining.length > 0) {
        log(`PREFLIGHT FAILED: ${remaining.join('; ')}`);
        process.stdout.write(`Preflight check failed: ${remaining.join('; ')}\n`);
        cleanup();
        process.exit(1);
      }
      log('PREFLIGHT: Issues auto-fixed');
    }

    // ── Task lifecycle: mark as running ─────────────────────────────
    const DB_CMD = path.join(HOME, 'bin/salvage-db');
    let heartbeatInterval = null;
    if (taskId) {
      try {
        execFileSync(DB_CMD, ['task', 'update', taskId, 'running'], { encoding: 'utf-8', timeout: 3000 });
        execFileSync(DB_CMD, ['task', 'heartbeat', taskId], { encoding: 'utf-8', timeout: 3000 });
        // Heartbeat: extend visibility timeout every 5 min while running
        heartbeatInterval = setInterval(() => {
          try { execFileSync(DB_CMD, ['task', 'heartbeat', taskId], { encoding: 'utf-8', timeout: 3000 }); }
          catch { log('WARNING: Task heartbeat failed'); }
        }, 300000); // 5 minutes
        log(`Task ${taskId}: marked running with heartbeat`);
      } catch (e) { log(`WARNING: Could not update task: ${e.message}`); }
    }

    // Extract user prompt for logging
    let userPrompt = '';
    for (let i = 0; i < passThroughArgs.length; i++) {
      if (passThroughArgs[i] === '-p' || passThroughArgs[i] === '--prompt') {
        userPrompt = passThroughArgs[i + 1] || '';
        break;
      }
    }

    // Execute before-call hooks
    await executeHooks(WORKSPACE, 'before-call', {
      workspace: WORKSPACE,
      taskType,
      sessionKey: resolvedSessionKey,
      promptTokens: budget.promptTokens,
      userPrompt,
    });

    // ── Tier 1-3: Failover Cascade ───────────────────────────────────
    // Two provider families:
    //   CLI family  — Claude (and future CLIs): subprocess, owns its own MCP/tools/session
    //   API family  — local LLMs (mlx-lm, Ollama): we own MCPClientManager + agentic loop
    let _model = config.model || 'default';
    for (let i = 0; i < passThroughArgs.length; i++) {
      if (passThroughArgs[i] === '--model') { _model = passThroughArgs[i + 1] || _model; break; }
    }
    const _isClaude = !_model || _model === 'default' || /^claude[-\s]|^(sonnet|opus|haiku)/i.test(_model);
    const localModel = !_isClaude
      ? (_model.startsWith('ollama/') ? _model.slice('ollama/'.length) : _model)
      : null;

    // Pre-warm MCPClientManager for API-family models in parallel with remaining setup.
    // Source: ollama-mcp-bridge/lifecycle.py — initialize at startup, not on first call.
    // Uses mcp-config-local.json (excludes Claude-dependent servers like mgc-proxy/vercel).
    const LOCAL_MCP_CONFIG = path.join(HOME, '.salvage/mcp-config-local.json');
    const mcpManager = new MCPClientManager();
    activeMcpManager = mcpManager;
    const mcpWarmPromise = localModel
      ? mcpManager.load(LOCAL_MCP_CONFIG)
      : Promise.resolve();

    // Attempt 1: Normal call (outerRetryLoop handles model-level recovery for local/API models)
    let result;
    if (localModel) {
      await mcpWarmPromise; // ensure MCP servers are ready before inference
      result = await outerRetryLoop(localModel, userPrompt, mcpManager);
    } else {
      result = await callClaude(1);
    }

    // API-family path: emit stream-json result event for callers using --output-format stream-json.
    // Claude CLI emits this natively; we replicate it for local LLM responses.
    if (localModel && result.code === 0) {
      const wantStreamJson = passThroughArgs.includes('stream-json');
      if (wantStreamJson) {
        // Leading \n ensures no partial prior output gets concatenated with the JSON.
        // sentProgressUpdates lets vanessa-worker know if Gemma sent mid-task Slack updates
        // so it can post a shorter final message instead of the full final_answer.
        process.stdout.write('\n' + JSON.stringify({
          type: 'result', subtype: 'success', result: result.stdout,
          sentProgressUpdates: result.meta?.sentProgressUpdates ?? 0,
        }) + '\n');
      } else {
        // Plain text callers (e.g. chatbox bridge with --output-format text)
        process.stdout.write(result.stdout);
      }
    }

    if (result.code !== 0) {
      const error = formatUserFacingError(result.code, result.stderr, result.stdout);
      log(`FAILOVER: Attempt 1 failed — ${error.category}: ${error.message}`);

      if (error.canAutoFix) {
        // ── Tier 1: Auto-retry with backoff ──────────────────────
        if (error.category === 'rate_limit' || error.category === 'overloaded' || error.category === 'network') {
          const backoff = [5000, 15000, 60000]; // 5s, 15s, 60s (OpenClaw pattern)
          for (let i = 0; i < backoff.length; i++) {
            log(`FAILOVER: Retry ${i + 2} after ${backoff[i] / 1000}s...`);
            await sleep(backoff[i]);
            result = await callClaude(i + 2);
            if (result.code === 0) break;
            const retryErr = formatUserFacingError(result.code, result.stderr, result.stdout);
            if (!retryErr.canAutoFix) break; // non-recoverable, stop retrying
          }
        }

        // ── Tier 2: Context overflow → fresh session ─────────────
        if (result.code !== 0 && error.category === 'context_overflow') {
          log('FAILOVER: Context overflow — starting fresh session');
          // Remove --continue from args if present
          const freshArgs = passThroughArgs.filter(a => a !== '--continue');
          // Re-build with fresh session
          const origAction = sessionDecision.action;
          sessionDecision.action = 'new';
          result = await callClaude(99);
          sessionDecision.action = origAction;
        }

        // ── Tier 2b: Auth error → re-read token ─────────────────
        if (result.code !== 0 && error.category === 'auth') {
          log('FAILOVER: Auth error — re-reading token');
          // Token file may have been refreshed by linkedin-refresh agent
          await sleep(2000);
          result = await callClaude(98);
        }

        // ── Tier 2c: Timeout → retry with --minimal ─────────────
        if (result.code !== 0 && error.category === 'timeout') {
          log('FAILOVER: Timeout — retrying with minimal prompt');
          minimal = true;
          // Rebuild a smaller prompt (skip most context)
          result = await callClaude(97);
        }
      }

      // ── Tier 3: Surface clean error ────────────────────────────
      if (result.code !== 0) {
        const finalError = formatUserFacingError(result.code, result.stderr, result.stdout);
        log(`FAILOVER EXHAUSTED: ${finalError.category} — ${finalError.message}`);
        // Output the clean error message (not raw stderr)
        if (!result.stdout.trim()) {
          process.stdout.write(finalError.message + '\n');
        }
      }
    }

    // Update session state
    try { updateSessionState(WORKSPACE, resolvedSessionKey, sessionDecision.action); } catch (e) {
      log(`WARNING: Could not update session state: ${e.message}`);
    }

    // ── Task lifecycle: mark completion ─────────────────────────────
    if (heartbeatInterval) clearInterval(heartbeatInterval);
    if (taskId) {
      try {
        const taskStatus = (result.code === 0) ? 'done' : 'failed';
        const taskResult = (result.code === 0) ? result.stdout.slice(0, 1000) : '';
        const taskError = (result.code !== 0) ? (result.stderr || result.stdout).slice(0, 500) : '';
        execFileSync(DB_CMD, ['task', 'update', taskId, taskStatus, taskResult, taskError], { encoding: 'utf-8', timeout: 3000 });
        log(`Task ${taskId}: marked ${taskStatus}`);
      } catch (e) { log(`WARNING: Could not complete task: ${e.message}`); }
    }

    // Execute after-call hooks
    await executeHooks(WORKSPACE, 'after-call', {
      workspace: WORKSPACE,
      taskType,
      sessionKey: resolvedSessionKey,
      promptTokens: budget.promptTokens,
      exitCode: result.code || 0,
      stdout: result.stdout,
      userPrompt,
    });

    // Append to daily note
    try { await appendDailyNote(userPrompt); } catch (e) {
      log(`WARNING: Could not append daily note: ${e.message}`);
    }

    cleanup();
    process.exit(result.code || 0);
  } catch (e) {
    log(`FATAL: ${e.message}`);
    cleanup();
    process.exit(1);
  }
}

main();
